---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/common/PageHeader.astro";
import SectionHeader from "../components/common/SectionHeader.astro";


const trainings = [
    {
        id: "training-2hr",
        duration: "2 Hours",
        title: "Digital Hygiene Workshop",
        subtitle: "Introductory & Interactive",
        description: "A concise digital security training covering the essentials, perfect for introducing your organization to cybersecurity fundamentals and best practices.",
        details: ["Focused on Digital Hygiene", "Issue-specific Training", "Short, focused cybersecurity"]
    },
    {
        id: "training-1day",
        duration: "1 Day",
        title: "Digital Hygiene",
        subtitle: "Behavioral & Foundational",
        description: "Custom digital security training tailored to your organization's specific security needs.",
        details: ["Digital security best practices", "Organization-specific training", "Hand-on digital security training"]
    },
    {
        id: "training-2day",
        duration: "2 Days",
        title: "Organizational DigiSec",
        subtitle: "Custom & Integrated",
        description: "Organization-specific digital security training that strengthens cybersecurity across your team's daily operations. Designed to integrate practical security measures and best practices into your existing workflows",
        details: ["Detailed digital security training", "Organizational threat modeling", "Hands-on digital security training"]
    },
    {
        id: "training-360",
        duration: "360° Audit",
        title: "Audit & Policy Development",
        subtitle: "Comprehensive Governance",
        description: "Conducting a comprehensive E2E security review of policies, practices, systems, and access credentials. On completion of the audit, we begin developing and building stronger security policies, training their team on implementation, and conducting a six-month follow-up review to measure progress and reinforce best practices.",
        details: ["System and access audit", "Policy creation & implementation", "6-month follow-up review"]
    },
    {
        id: "training-3day",
        duration: "3 Days",
        title: "HRD's & CSO's Security Program",
        subtitle: "Strategic & Applied Threat Modeling",
        description: "Purpose-building for Human Rights Defenders (HRDs) and Civil Society Organizations (CSOs), we combine digital hygiene assessments, advanced threat modeling, and customizable enhancements to deliver a personalized digital security roadmap with clear, actionable recommendations.",
        details: ["Detailed digital security training", "Threat modeling exercise", "Lessons from Real Incidents"]
    },
    {
        id: "training-tft",
        duration: "Trainers Program",
        title: "T for T (Training for Trainers)",
        subtitle: "Capacity Scaling",
        description: "Empowering organizational leaders and IT admins with the skills, resources, and pedagogical knowledge to train others. Scales cybersecurity capability internally and builds long-term organizational resilience.",
        details: ["Train the trainer curriculum", "Resource packs & guides", "Internal teaching strategies"]
    },
    {
        id: "training-modules",
        duration: "Add-on Modules",
        title: "Personalized Digital Security Modules",
        subtitle: "Comprehensive Governance",
        description: "Specifically curated technical training modules designed to complement other training packages or be delivered as standalone training.",
        details: ["Incident Response", "Digital Literacy Training", "Security Audit","On-Demand Focused Training"],
        banner: "/images/IMG_0467.jpg"
    }
];



const coreServices = [
    {
        id: "core-kiosk",
        title: "Digital Security Kiosk",
        banner: "/images/kiosk.jpg",
        icon: ``,
        subtitle: "1-3 Day Events",
        description: "An on-site kiosk run by our digital security experts and specifically designed to provide in person support during your workshops, trainings, campaigns, or conferences.",
        items: [
            "Providing live digital security helpdesk and support services during the event.",
            "Forensics and in-depth analysis of devices for threats, malware, and configuration issues.",
            "Dedicated on-site digital security support for organizers and key speakers.",
            "Raising awareness around digital security issues identified specifically for the event context."
        ]
    },
    {
        id: "core-secured",
        title: "Secured by TibCERT",
        icon : "/images/secured-by-tibcert.png",
        description: "Protect your digital presence and earn the “Secured by TibCERT” Badge for your website and/or organization.",
        items: [
            "Securing public facing interfaces including websites, social media, and web servers.",
            "Deploying advanced endpoint detection tools (EDR) across organization devices.",
            "Review and development of customized organizational digital security policy.",
            "Interactive training and long-term capacity building for the entire internal team."
        ]
    },
    
];

const description = "Tailored cybersecurity services, intensive training programs, and direct incident response capabilities that help Tibetans and Tibet Support organizations build digital resilience.";
---

<Layout title="Services // Capabilities" description={description}>
    <main class="pt-32 pb-24 relative overflow-hidden bg-brand-bg min-h-screen">
        <div class="container mx-auto px-4 pb-12">
            <PageHeader
                eyebrow=""
                title="SERVICES"
                titleAccent=""
                description={description}
            />

            <!-- Digital Security Trainings -->
            <div class="mb-28 reveal" id="trainings-section">
                    <div class="mb-12">
                        <SectionHeader
                            eyebrow=""
                            title="Digital Security"
                            titleAccent="Trainings"
                            description="Modular, behavior-centric, and technical educational workshops structured around organizational scale and user risk profiles."
                        />
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                        {
                            trainings.filter(t => t.id !== "training-modules").map((training) => (
                                    <div 
                                        id={training.id}
                                        class="group relative bg-brand-surface/[0.03] hover:bg-brand-surface/[0.07] border border-brand-text/5 hover:border-brand-red/30 p-8 transition-all duration-500 flex flex-col justify-between"
                                    >
                                        <!-- High-tech Corner Accents -->
                                        <div class="absolute top-0 left-0 w-2 h-2 border-t border-l border-brand-text/10 group-hover:border-brand-red/40 transition-colors"></div>
                                        <div class="absolute bottom-0 right-0 w-2 h-2 border-b border-r border-brand-text/10 group-hover:border-brand-red/40 transition-colors"></div>
                                        
                                        <div>
                                            <!-- Duration Badge -->
                                            <div class="flex justify-between items-center mb-6">
                                                <span class="font-mono text-[9px] text-brand-red bg-brand-red/5 border border-brand-red/20 px-2.5 py-0.5 tracking-wider uppercase font-semibold">
                                                    {training.duration}
                                                </span>
                                                {/* <span class="font-mono text-[9px] text-brand-muted/40 uppercase tracking-widest">
                                                    [ TRAINING ]
                                                </span> */}
                                            </div>

                                            <!-- Card Header -->
                                            <h3 class="text-xl font-black text-brand-text mb-1 uppercase tracking-tight italic group-hover:text-brand-red transition-colors">
                                                {training.title}
                                            </h3>
                                            <span class="font-mono text-[9px] text-brand-red/70 uppercase tracking-[0.2em] mb-4 block">
                                                {training.subtitle}
                                            </span>

                                            <p class="text-sm text-brand-muted font-light leading-relaxed mb-6">
                                                {training.description}
                                            </p>
                                        </div>

                                        <!-- Technical Details List -->
                                        <ul class="border-t border-brand-text/5 pt-4 space-y-2">
                                            {training.details.map((detail) => (
                                                <li class="flex items-center gap-2 text-[10px] font-mono text-brand-muted/70">
                                                    <span class="w-1 h-1 bg-brand-red shrink-0" />
                                                    <span class="uppercase tracking-wider">{detail}</span>
                                                </li>
                                            ))}
                                        </ul>
                                    </div>
                            ))
                        }
                    </div>

                    <!-- Highlighted Modules & Kiosk side-by-side -->
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 my-12">
                        {
                            trainings.filter(t => t.id === "training-modules").map((training) => (
                                <div 
                                    id={training.id}
                                    class="group relative overflow-hidden bg-brand-surface/[0.02] hover:bg-brand-surface/[0.05] border border-brand-text/5 hover:border-brand-red/20 p-8 md:p-10 transition-all duration-500 flex flex-col justify-between"
                                >
                                    <!-- Tech Accents -->
                                    <div class="absolute top-0 left-0 w-3 h-3 border-t border-l border-brand-text/10 group-hover:border-brand-red/30 transition-colors pointer-events-none"></div>
                                    <div class="absolute top-0 right-0 w-3 h-3 border-t border-r border-brand-text/10 group-hover:border-brand-red/30 transition-colors pointer-events-none"></div>
                                    <div class="absolute bottom-0 left-0 w-3 h-3 border-b border-l border-brand-text/10 group-hover:border-brand-red/30 transition-colors pointer-events-none"></div>
                                    <div class="absolute bottom-0 right-0 w-3 h-3 border-b border-r border-brand-text/10 group-hover:border-brand-red/30 transition-colors pointer-events-none"></div>
                                    
                                    <div class="absolute inset-0 bg-[radial-gradient(circle_at_bottom_left,rgba(239,72,44,0.02),transparent_60%)] pointer-events-none"></div>

                                    {training.banner && (
                                        <div 
                                            class="absolute inset-0 bg-cover bg-center opacity-[0.08] pointer-events-none group-hover:opacity-[0.12] transition-opacity duration-500 z-0" 
                                            style={`background-image: url('${training.banner}');`}
                                        ></div>
                                    )}

                                    <div class="flex flex-col justify-between h-full relative z-10 gap-8">
                                        <div class="flex flex-col items-start text-left">
                                            <h2 class="text-3xl font-black text-brand-text mb-3 italic group-hover:text-brand-red transition-colors">
                                                {training.title}
                                            </h2>
                                            <p class="text-brand-muted text-sm font-light leading-relaxed">
                                                {training.description}
                                            </p>
                                        </div>

                                        <div class="border-t border-brand-text/5 pt-6">
                                            <ul class="space-y-4">
                                                {training.details.map((detail) => (
                                                    <li class="flex items-start gap-3 text-brand-muted group-hover:text-brand-text transition-colors duration-500">
                                                        <span class="text-brand-red font-light shrink-0 select-none">&gt;</span>
                                                        <span class="text-sm md:text-base font-light leading-relaxed">{detail}</span>
                                                    </li>
                                                ))}
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            ))
                        }
                        {
                            coreServices.filter(s => s.id === "core-kiosk").map((service) => (
                                <div 
                                    id={service.id} 
                                    class="group relative bg-brand-surface/[0.02] hover:bg-brand-surface/[0.05] border border-brand-text/5 hover:border-brand-red/20 p-8 md:p-10 transition-all duration-500 overflow-hidden flex flex-col justify-between"
                                >
                                    <!-- Tech Accents -->
                                    <div class="absolute top-0 left-0 w-3 h-3 border-t border-l border-brand-text/10 group-hover:border-brand-red/30 transition-colors pointer-events-none"></div>
                                    <div class="absolute top-0 right-0 w-3 h-3 border-t border-r border-brand-text/10 group-hover:border-brand-red/30 transition-colors pointer-events-none"></div>
                                    <div class="absolute bottom-0 left-0 w-3 h-3 border-b border-l border-brand-text/10 group-hover:border-brand-red/30 transition-colors pointer-events-none"></div>
                                    <div class="absolute bottom-0 right-0 w-3 h-3 border-b border-r border-brand-text/10 group-hover:border-brand-red/30 transition-colors pointer-events-none"></div>
                                    
                                    <div class="absolute inset-0 bg-[radial-gradient(circle_at_bottom_left,rgba(239,72,44,0.02),transparent_60%)] pointer-events-none"></div>

                                    {service.banner && (
                                        <div 
                                            class="absolute inset-0 bg-cover bg-center opacity-[0.08] pointer-events-none group-hover:opacity-[0.12] transition-opacity duration-500 z-0" 
                                            style={`background-image: url('${service.banner}');`}
                                        ></div>
                                    )}

                                    <div class="flex flex-col justify-between h-full relative z-10 gap-8">
                                       <!-- Top: Title and Description -->
                                       <div class="flex flex-col items-start text-left">
                                           {service.icon && service.icon.trim() !== '' && (
                                               <div class="mb-6">
                                                   {service.icon.trim().startsWith('<svg') ? (
                                                       <div class="w-16 h-16 flex items-center justify-center bg-brand-void border border-brand-text/10 rounded-sm p-3 text-brand-red group-hover:border-brand-red/30 transition-colors">
                                                           <Fragment set:html={service.icon} />
                                                       </div>
                                                   ) : (
                                                       <img src={service.icon} alt={service.title} class="w-20 h-auto object-contain" />
                                                   )}
                                               </div>
                                           )}
                                           <h2 class="text-3xl font-black text-brand-text mb-3 italic group-hover:text-brand-red transition-colors">
                                               {service.title}
                                           </h2> 
                                           <p class="text-brand-muted text-sm font-light leading-relaxed">{service.description}</p>
                                       </div>

                                       <!-- Bottom: Bullet Points -->
                                        <div class="border-t border-brand-text/5 pt-6">
                                            <ul class="space-y-4">
                                                    {service.items.map((item) => (
                                                        <li class="flex items-start gap-3 text-brand-muted group-hover:text-brand-text transition-colors duration-500">
                                                            <span class="text-brand-red font-light shrink-0 select-none">&gt;</span>
                                                            <span class="text-sm md:text-base font-light leading-relaxed">{item}</span>
                                                        </li>
                                                    ))}
                                            </ul>
                                        </div>  
                                    </div>
                                </div>
                            ))
                        }
                    </div>

                    <!-- Remaining Core Services (e.g. Secured by TibCERT) -->
                    <div class="space-y-12 my-12">
                    {
                        coreServices.filter(s => s.id !== "core-kiosk").map((service) => (
                            <div 
                                id={service.id} 
                                class="group relative bg-brand-surface/[0.02] hover:bg-brand-surface/[0.05] border border-brand-text/5 hover:border-brand-red/20 p-8 md:p-12 transition-all duration-500 overflow-hidden"
                            >
                                <!-- Tech Accents -->
                                <div class="absolute top-0 left-0 w-3 h-3 border-t border-l border-brand-text/10 group-hover:border-brand-red/30 transition-colors pointer-events-none"></div>
                                <div class="absolute top-0 right-0 w-3 h-3 border-t border-r border-brand-text/10 group-hover:border-brand-red/30 transition-colors pointer-events-none"></div>
                                <div class="absolute bottom-0 left-0 w-3 h-3 border-b border-l border-brand-text/10 group-hover:border-brand-red/30 transition-colors pointer-events-none"></div>
                                <div class="absolute bottom-0 right-0 w-3 h-3 border-b border-r border-brand-text/10 group-hover:border-brand-red/30 transition-colors pointer-events-none"></div>
                                
                                <div class="absolute inset-0 bg-[radial-gradient(circle_at_bottom_left,rgba(239,72,44,0.02),transparent_60%)] pointer-events-none"></div>

                                {service.banner && (
                                    <div 
                                        class="absolute inset-0 bg-cover bg-center opacity-[0.08] pointer-events-none group-hover:opacity-[0.12] transition-opacity duration-500 z-0" 
                                        style={`background-image: url('${service.banner}');`}
                                    ></div>
                                )}

                                <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start relative z-10">
                                   <!-- Left Column: Title and Description -->
                                   <div class="md:col-span-5 lg:col-span-4 flex flex-col items-center md:items-center text-center md:text-center">
                                       {service.icon && service.icon.trim() !== '' && (
                                           <div class="mb-6">
                                               {service.icon.trim().startsWith('<svg') ? (
                                                   <div class="w-16 h-16 flex items-center justify-center bg-brand-void border border-brand-text/10 rounded-sm p-3 text-brand-red group-hover:border-brand-red/30 transition-colors">
                                                       <Fragment set:html={service.icon} />
                                                   </div>
                                               ) : (
                                                   <img src={service.icon} alt={service.title} class="w-20 h-auto object-contain mx-auto md:mx-0" />
                                               )}
                                           </div>
                                       )}
                                       <h2 class="text-3xl  font-black text-brand-text mb-3  italic group-hover:text-brand-red transition-color ">
                                           {service.title}
                                       </h2> 
                                       <p class="text-brand-muted text-sm font-light leading-relaxed">{service.description}</p>
                                   </div>

                                   <!-- Right Column: Bullet Points -->
                                    <div class="md:col-span-7 lg:col-span-8 h-full flex flex-col justify-center">
                                        <ul class="space-y-4 md:border-l md:border-brand-text/5 md:pl-8">
                                                {service.items.map((item) => (
                                                    <li class="flex items-start gap-3 text-brand-muted group-hover:text-brand-text transition-colors duration-500">
                                                        <span class="text-brand-red font-light shrink-0 select-none">&gt;</span>
                                                        <span class="text-sm md:text-base font-light leading-relaxed">{item}</span>
                                                    </li>
                                                ))}
                                        </ul>
                                    </div>  
                                </div>
                            </div>
                        ))
                    }
                    </div>
                    </div>
          
                    <div class=" flex">
                        <div
                        class="bg-brand-void border border-brand-text/5 px-10 py-4 rounded-sm backdrop-blur-sm inline-flex items-center gap-6 group hover:border-brand-red/30 transition-colors mx-auto max-w-3xl" >
                        <div
                            class="w-2 h-2 bg-brand-red rounded-full animate-pulse"
                        >
                        </div>
                        <div class="font-mono text-sm w-full text-brand-muted text-center">
                            <p class="leading-relaxed">
                                Our technology services are available to any individual or organization looking to educate and elevate their digital needs. Please contact us if you wish to learn more about our offerings and how we can support you. Our team will be happy to discuss your specific needs, and provide further information, including service packages, curated modules, and associated rates. 
                            </p>
                            <p class="mt-4 leading-relaxed">Our team can be reached at: info(at)tibcert.org</p>
                        </div>
                        <div
                            class="w-2 h-2 bg-brand-red rounded-full animate-pulse"
                        >
                        </div>
                    </div>

                </div>
                
            </div>
            
        </div>

        
        
    </main>
</Layout>

<style>
    .reveal {
        opacity: 0;
        transform: translateY(20px);
        transition: all 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .reveal.revealed {
        opacity: 1;
        transform: translateY(0);
    }
</style>
