---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/common/PageHeader.astro";
import SectionHeader from "../components/common/SectionHeader.astro";


const trainings = [
    {
        id: "training-2hr",
        duration: "2 Hours",
        title: "Digital Hygiene Workshop",
        subtitle: "Introductory & Interactive",
        description: "Introductory digital security practices combined with collaborative team-building exercises. Ideal for quick check-ins and raising general baseline awareness.",
        details: ["Basic digital security practices", "Team building activities", "Interactive workshop format"]
    },
    {
        id: "training-1day",
        duration: "1 Day",
        title: "Digital Hygiene",
        subtitle: "Behavioral & Foundational",
        description: "Focuses on foundational capacity building and digital hygiene best practices. Designed to be accessible and non-technical, focusing primarily on digital habits and behavioral security.",
        details: ["Behavioral security habits", "Best practices definition", "Non-technical accessibility"]
    },
    {
        id: "training-2day",
        duration: "2 Days",
        title: "Organizational DigiSec",
        subtitle: "Custom & Integrated",
        description: "Customized training modules based on the organization's unique structure. Curated specifically for your organization, integrating various security aspects and workflows into your active environment.",
        details: ["Organization-specific modules", "Workflow integration", "Tailored security guidelines"]
    },
    {
        id: "training-360",
        duration: "360° Audit",
        title: "Audit & Policy Development",
        subtitle: "Comprehensive Governance",
        description: "An end-to-end security review. We audit policies, practices, systems, and access credentials. Following the audit, we develop and build new security policies, train your team to implement them, and conduct a 6-month review checkup.",
        details: ["System and access audit", "Policy creation & implementation", "6-month follow-up review"]
    },
    {
        id: "training-3day",
        duration: "3 Days",
        title: "HRDs & CSOs Security Program",
        subtitle: "Strategic & Applied Threat Modeling",
        description: "Specifically created for Human Rights Defenders (HRDs) and Civil Society Organizations (CSOs). Covers digital hygiene, advanced threat modeling, and includes custom add-ons to build a personalized roadmap/digital security workplan.",
        details: ["Human Rights Defenders focus", "Threat modeling exercises", "Personalized digital security workplan"]
    },
    {
        id: "training-tft",
        duration: "Trainers Program",
        title: "T for T (Training for Trainers)",
        subtitle: "Capacity Scaling",
        description: "Empowering organizational leaders and IT admins with the skills, resources, and pedagogical knowledge to train others. Scales cybersecurity capability internally and builds long-term organizational resilience.",
        details: ["Train the trainer curriculum", "Resource packs & guides", "Internal teaching strategies"]
    },
    {
        id: "training-modules",
        duration: "Add-on Modules",
        title: "Additional digital security modules",
        subtitle: "Comprehensive Governance",
        description: "Specialized add-on courses designed to integrate with larger training packages or run as standalone technical modules.",
        details: ["AI policy development", "MDM training", "Social Media advocacy and metrics"]
    }
];

const movementBuilding = {
    id: "movement-building",
    duration: "1 Week Intensive",
    title: "Movement Building Training",
    description: "A weeklong intensive training: How to build a movement based on the learned experiences of the Tibetan movement. Using Technology, building community, building capacity, building knowledge. … etc ",
    highlights: [
        "Leveraging technology for safe mobilization",
        "Community & capacity building strategies",
        "Knowledge scaling & secure institutional memory"
    ]
};

const coreServices = [
    {
        id: "core-secured",
        title: "“Secured by TibCERT”",
        description: "A comprehensive support framework to secure organization infrastructure and critical workflows.",
        items: [
            "Securing public facing interfaces including websites, social media, and web servers.",
            "Deploying advanced endpoint detection tools (EDR) across organization devices.",
            "Review and development of customized organizational digital security policy.",
            "Interactive training and long-term capacity building for the entire internal team."
        ]
    },
    {
        id: "core-kiosk",
        title: "Digital Security Kiosk",
        subtitle: "1-3 Day Events",
        description: "On-site and temporary security support desk deployed directly at your workshops, campaigns, or conferences.",
        items: [
            "Providing live digital security helpdesk and support services during the event.",
            "Forensics and in-depth analysis of devices for threats, malware, and configuration issues.",
            "Dedicated on-site digital security support for organizers and key speakers.",
            "Raising awareness around digital security issues identified specifically for the event context."
        ]
    }
];
---

<Layout title="Services // Capabilities">
    <main class="pt-32 pb-24 relative overflow-hidden bg-brand-bg min-h-screen">
        <div class="container mx-auto px-4 pb-12">
            <PageHeader
                eyebrow=""
                title="SERVICES"
                titleAccent=""
                description="Tailored cybersecurity services, intensive training programs, and direct incident response capabilities that help Tibetan and Tibet Support organizations build digital resilience."
            />

            <!-- Digital Security Trainings -->
            <div class="mb-28 reveal" id="trainings-section">
                    <div class="mb-12">
                        <SectionHeader
                            eyebrow="Part_01 // Training Programs"
                            title="Digital Security"
                            titleAccent="Trainings"
                            description="Modular, behavior-centric, and technical educational workshops structured around organizational scale and user risk profiles."
                        />
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                        {
                            trainings.map((training) => (
                                training.id === "training-modules" ? (
                                    <div 
                                        id={training.id}
                                        class="relative overflow-hidden bg-brand-surface/[0.02] border border-brand-text/5 p-8 md:p-12 md:col-span-2 lg:col-span-3 text-left"
                                    >
                                        <!-- High-tech tech grid backdrop & border glow -->
                                        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(220,38,38,0.05),transparent_60%)] pointer-events-none"></div>
                                        <div class="absolute top-0 left-0 w-3 h-3 border-t border-l border-brand-red/30"></div>
                                        <div class="absolute bottom-0 right-0 w-3 h-3 border-b border-r border-brand-red/30"></div>

                                        <div class="grid lg:grid-cols-12 gap-8 items-center relative z-10">
                                            <div class="lg:col-span-7">
                                                <div class="flex items-center gap-3 mb-4">
                                                    <span class="font-mono text-[9px] text-brand-red bg-brand-red/10 border border-brand-red/30 px-3 py-0.5 tracking-wider uppercase font-semibold">
                                                        {training.duration}
                                                    </span>
                                                  
                                                </div>

                                                <h3 class="text-2xl md:text-3xl font-black text-brand-text mb-4  tracking-tighter italic">
                                                    {training.title}
                                                </h3>
                                                <p class="text-brand-muted text-sm md:text-base font-light leading-relaxed">
                                                    {training.description}
                                                </p>
                                            </div>

                                            <div class="lg:col-span-5 lg:pl-8">
                                                <div class="bg-brand-void/50 border border-brand-text/5 p-6 relative">
                                                   
                                                    <ul class="space-y-3 font-mono text-[10px] text-brand-muted">
                                                        {training.details.map((detail) => (
                                                            <li class="flex items-start gap-2.5">
                                                                <span class="text-brand-red font-semibold shrink-0">&gt;</span>
                                                                <span class="uppercase tracking-wider">{detail}</span>
                                                            </li>
                                                        ))}
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                ) : (
                                    <div 
                                        id={training.id}
                                        class="group relative bg-brand-surface/[0.03] hover:bg-brand-surface/[0.07] border border-brand-text/5 hover:border-brand-red/30 p-8 transition-all duration-500 flex flex-col justify-between"
                                    >
                                        <!-- High-tech Corner Accents -->
                                        <div class="absolute top-0 left-0 w-2 h-2 border-t border-l border-brand-text/10 group-hover:border-brand-red/40 transition-colors"></div>
                                        <div class="absolute bottom-0 right-0 w-2 h-2 border-b border-r border-brand-text/10 group-hover:border-brand-red/40 transition-colors"></div>
                                        
                                        <div>
                                            <!-- Duration Badge -->
                                            <div class="flex justify-between items-center mb-6">
                                                <span class="font-mono text-[9px] text-brand-red bg-brand-red/5 border border-brand-red/20 px-2.5 py-0.5 tracking-wider uppercase font-semibold">
                                                    {training.duration}
                                                </span>
                                                {/* <span class="font-mono text-[9px] text-brand-muted/40 uppercase tracking-widest">
                                                    [ TRAINING ]
                                                </span> */}
                                            </div>

                                            <!-- Card Header -->
                                            <h3 class="text-xl font-black text-brand-text mb-1 uppercase tracking-tight italic group-hover:text-brand-red transition-colors">
                                                {training.title}
                                            </h3>
                                            <span class="font-mono text-[9px] text-brand-red/70 uppercase tracking-[0.2em] mb-4 block">
                                                {training.subtitle}
                                            </span>

                                            <p class="text-sm text-brand-muted font-light leading-relaxed mb-6">
                                                {training.description}
                                            </p>
                                        </div>

                                        <!-- Technical Details List -->
                                        <ul class="border-t border-brand-text/5 pt-4 space-y-2">
                                            {training.details.map((detail) => (
                                                <li class="flex items-center gap-2 text-[10px] font-mono text-brand-muted/70">
                                                    <span class="w-1 h-1 bg-brand-red shrink-0" />
                                                    <span class="uppercase tracking-wider">{detail}</span>
                                                </li>
                                            ))}
                                        </ul>
                                    </div>
                                )
                            ))
                        }
                    </div>
            </div>

        </div>
        
    </main>
</Layout>

<style>
    .reveal {
        opacity: 0;
        transform: translateY(20px);
        transition: all 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .reveal.revealed {
        opacity: 1;
        transform: translateY(0);
    }
</style>
