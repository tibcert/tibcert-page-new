<Layout title="Contact | TIBCERT">
    <main class="pt-32 pb-24 relative overflow-hidden bg-brand-bg min-h-screen">
        <!-- Premium Radial Glow -->
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[800px] bg-[radial-gradient(circle_at_50%_-20%,rgba(220,38,38,0.15),transparent_70%)] pointer-events-none"></div>

        <!-- Background Grid -->
        <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:60px_60px] [mask-image:radial-gradient(ellipse_at_center,black,transparent_90%)] -z-10"></div>

        <div class="container mx-auto px-6 relative z-10">
            <div class="max-w-7xl mx-auto">
                <!-- Header Section -->
                <div class="max-w-4xl mb-20 reveal relative">
                    <!-- Technical Brackets -->
                    <div class="absolute -top-12 -left-12 w-16 h-16 border-t border-l border-brand-red/20 uppercase opacity-60"></div>
                    
                    <span class="font-mono text-[10px] text-brand-red tracking-[0.4em] mb-4 block uppercase opacity-60">Guaranteed response within 24 hours //</span>
                    <h1 class="text-5xl md:text-8xl font-black mb-8 text-brand-text leading-none uppercase tracking-tighter italic">
                     Contact   <span class="text-brand-red">Us</span>
                    </h1>
                    <SectionDivider class="text-brand-red w-48 mb-8" />
                    <p class="text-base md:text-lg text-brand-muted leading-relaxed font-light max-w-2xl">
                        Need assistance or want to coordinate? Reach out directly through our specific secure channels.
                    </p>
                </div>

                <!-- Contact Grid -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-24 reveal">
                    {
                        contactMethods.map((method, index) => (
                            <div class="bg-brand-void/40 border border-brand-text/5 p-8 relative group overflow-hidden transition-all duration-300 hover:border-brand-red/35 flex flex-col justify-between h-full">
                                <div class="absolute top-0 right-0 w-3 h-3 border-t border-r border-brand-text/10 group-hover:border-brand-red/40 transition-colors"></div>
                                <div class="absolute bottom-0 left-0 w-3 h-3 border-b border-l border-brand-text/10 group-hover:border-brand-red/40 transition-colors"></div>

                                <div>
                                    <div class="flex items-center justify-between mb-6">
                                        <span class="font-mono text-[9px] text-brand-red tracking-[0.3em] font-bold">{method.tag}{index + 1}</span>
                                        <div class="w-10 h-10 border border-brand-text/5 flex items-center justify-center text-brand-red/40 group-hover:text-brand-red group-hover:border-brand-red/20 transition-all">
                                            <Fragment set:html={method.icon} />
                                        </div>
                                    </div>

                                    <h3 class="text-2xl font-black text-brand-text mb-1 uppercase tracking-tight italic">
                                        {method.title}
                                    </h3>
                                   
                                    
                                    <p class="text-brand-muted text-sm leading-relaxed mb-6 font-light">
                                        {method.description}
                                    </p>
                                </div>

                                <div class="mt-auto pt-6 border-t border-brand-text/5 space-y-4">
                                    <div>
                                        <span class="font-mono text-[8px] uppercase tracking-widest text-brand-muted/40 block mb-1">Email Address:</span>
                                        <a href={`mailto:${method.email}`} class="text-sm font-mono text-brand-red hover:underline break-all">{method.email}</a>
                                    </div>

                                    <!-- Collapsible PGP Section -->
                                    <details class="group border-t border-brand-text/5 pt-4">
                                        <summary class="list-none flex items-center justify-between text-[9px] font-mono text-brand-muted/70 hover:text-brand-red uppercase tracking-widest cursor-pointer select-none">
                                            <span>[ PGP_KEY_DETAILS ]</span>
                                            <span class="transition-transform group-open:rotate-180 font-bold">&darr;</span>
                                        </summary>
                                        
                                        <div class="space-y-4 text-left font-mono text-[9px] uppercase tracking-widest text-brand-muted mt-4 bg-black/40 p-4 border border-brand-text/5">
                                            <div>
                                                <span class="opacity-40">Key ID:</span>
                                                <span class="text-brand-text block mt-0.5 select-all">{method.pgp}</span>
                                            </div>
                                            <div>
                                                <span class="opacity-40">Fingerprint:</span>
                                                <span class="text-brand-text block mt-0.5 break-all select-all">{method.fingerprint}</span>
                                            </div>
                                            <div class="pt-2 flex gap-4 border-t border-brand-text/5">
                                                <button
                                                    class="copy-pgp-btn text-brand-red hover:text-white transition-colors cursor-pointer"
                                                    data-key={method.keyBlock}
                                                >
                                                    [ COPY_BLOCK ]
                                                </button>
                                                <span class="opacity-20">|</span>
                                                <a
                                                    href={`data:text/plain;charset=utf-8,${encodeURIComponent(method.keyBlock)}`}
                                                    download={`tibcert-key-${method.id.toLowerCase()}.asc`}
                                                    class="text-brand-muted hover:text-brand-red transition-colors"
                                                >
                                                    [ DOWNLOAD ]
                                                </a>
                                            </div>
                                        </div>
                                    </details>
                                </div>
                            </div>
                        ))
                    }
                </div>

                <!-- Additional Security Notice -->
                <div class="max-w-4xl mx-auto p-10 bg-brand-red/[0.03] border border-brand-red/20 relative reveal">
                    <div class="absolute top-0 left-0 w-2 h-2 bg-brand-red"></div>
                    <div class="flex flex-col sm:flex-row gap-6 items-start">
                        <div class="text-brand-red text-3xl opacity-50 shrink-0">⚠️</div>
                        <div>
                            <h4 class="text-brand-red font-black uppercase tracking-tight mb-3 italic">Security Alert</h4>
                            <p class="text-brand-red text-sm leading-relaxed font-light">
                                When reporting sensitive security incidents, we strongly recommend encrypting your email using PGP. 
                                If you suspect your network or current device is actively compromised, please utilize a secondary 
                                secure network and device to establish contact.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</Layout>

<script>
    document.querySelectorAll('.copy-pgp-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
            const keyBlock = btn.getAttribute('data-key');
            if (keyBlock) {
                try {
                    await navigator.clipboard.writeText(keyBlock.trim());
                    const originalText = btn.textContent;
                    btn.textContent = "[ COPIED! ]";
                    btn.classList.add('text-green-400');
                    setTimeout(() => {
                        btn.textContent = originalText;
                        btn.classList.remove('text-green-400');
                    }, 2000);
                } catch (err) {
                    console.error('Failed to copy PGP key', err);
                }
            }
        });
    });
</script>

<style>
    .reveal {
        opacity: 0;
        transform: translateY(20px);
        transition: all 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .reveal.revealed {
        opacity: 1;
        transform: translateY(0);
    }
    
    /* Remove default details marker */
    details summary::-webkit-details-marker {
        display: none;
    }
    details summary {
        list-style: none;
    }
</style>
