---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/common/PageHeader.astro";
import SectionHeader from "../components/common/SectionHeader.astro";
import ServicesPreview from "../components/landing/ServicesPreview.astro";
const resources = [
    {
        name: "TibCERT Blog",
        description: "Stay updated with the latest security advisories, incident reports, and digital security news from the Tibetan community.",
        link: "https://blog.tibcert.org",
        icon: "blog",
        category: "Updates"
    },
    {
        name: "TibCERT Learn",
        description: "Comprehensive digital security guides, tutorials, and training materials designed for the Tibetan community.",
        link: "https://learn.tibcert.org",
        icon: "learn",
        category: "Education"
    },
    {
        name: "Digital Disruption",
        description: "A platform dedicated to analyzing and tracking digital threats and disruptions affecting the Tibetan diaspora.",
        link: "https://digital-disruption.tibcert.org/",
        icon: "disruption",
        category: "Research"
    }
];
---

<Layout title="Resources | TibCERT">
      <main class="pt-32 pb-24 relative overflow-hidden bg-brand-bg min-h-screen">
        <!-- Page Heading (Same style as about page) -->
        <div class="container mx-auto px-4 pb-16 pt-8">
            <PageHeader
                eyebrow=""
                title="COMMUNITY"
                titleAccent=""
                description="Tailored cybersecurity services, intensive training programs, and direct incident response capabilities that help Tibetan and Tibet Support organizations build digital resilience."
            />
        </div>

        <!-- Services Grid (Moved from home page) -->
        <ServicesPreview
            hideHeader={true}
            class="pb-16 bg-brand-void relative overflow-hidden reveal"
        />

        <div class="container mx-auto px-4 mt-20">
            <!-- Header Section -->
            <div class="mb-12">
                <SectionHeader
                    eyebrow="PART_02 // KNOWLEDGE_BASE"
                    title="Tools &"
                    titleAccent="Resources"
                    description="Centralized access to specialized community toolkits, documentation, and digital security assets."
                />
            </div>

            <!-- Platform Cards (Tech-Spec Style) -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-brand-text/5 border border-brand-text/5">
                {
                    resources.map((resource, index) => (
                        <div class="bg-brand-void group relative overflow-hidden">
                            <!-- Technical Border Accents -->
                            <div class="absolute top-0 left-0 w-2 h-2 border-t border-l border-brand-text/10 group-hover:border-brand-red/40 transition-colors"></div>
                            <div class="absolute bottom-0 right-0 w-2 h-2 border-b border-r border-brand-text/10 group-hover:border-brand-red/40 transition-colors"></div>

                            <div class="p-8 md:p-10 hover:bg-brand-red/[0.01] transition-all duration-500 h-full flex flex-col relative">
                                <!-- Category & ID -->
                                <div class="flex items-center justify-between mb-8">
                                    <div class="flex flex-col">
                                        <span class="font-mono text-[8px] text-brand-red tracking-[0.3em] mb-1 uppercase opacity-60">REF_ID_{String(index + 1).padStart(2, '0')}</span>
                                        <span class="font-mono text-[9px] text-brand-text uppercase tracking-widest font-black">
                                            {resource.category}
                                        </span>
                                    </div>
                                    <div class="h-8 w-8 border border-brand-text/5 flex items-center justify-center text-brand-red/40 group-hover:text-brand-red group-hover:border-brand-red/20 transition-all">
                                        {resource.icon === 'blog' && (
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-[18px] h-[18px]"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"></path><path d="M18 14h-8"></path><path d="M15 18h-5"></path><path d="M10 6h8v4h-8V6Z"></path></svg>
                                        )}
                                        {resource.icon === 'learn' && (
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-[18px] h-[18px]"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
                                        )}
                                        {resource.icon === 'disruption' && (
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-[18px] h-[18px]"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                                        )}
                                    </div>
                                </div>
                                
                                <h3 class="text-2xl font-black text-brand-red mb-4 group-hover:text-brand-red transition-colors leading-tight  tracking-tight italic">
                                    <a href={resource.link} target="_blank" rel="noopener noreferrer" class="hover:underline">
                                        {resource.name}
                                    </a>
                                </h3>
                                <p class="text-brand-muted text-sm leading-relaxed mb-10 flex-grow font-light">
                                    {resource.description}
                                </p>
                                
                                <div class="mt-auto space-y-6">
                                    <div class="flex items-center justify-between font-mono text-[9px] uppercase tracking-widest text-brand-muted/40">
                                        <span>Site URL</span>
                                        <span class="text-brand-red opacity-80"><a href={resource.link} target="_blank" rel="noopener noreferrer" class="hover:underline">{resource.link}</a></span>
                                    </div>
                                    
                                    <a
                                        href={resource.link}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="flex items-center justify-between w-full group/link"
                                    >
                                        <span class="font-mono text-[10px] text-brand-red uppercase tracking-[0.2em] transition-transform group-hover/link:translate-x-1">
                                            [ ACCESS_PLATFORM ]
                                        </span>
                                        <div class="h-px flex-grow mx-4 bg-brand-text/5 group-hover/link:bg-brand-red/20 transition-colors"></div>
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-red/40 group-hover/link:text-brand-red transition-colors"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                                    </a>
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </main>

</Layout>

<style>
    .reveal {
        opacity: 0;
        transform: translateY(20px);
        transition: all 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .reveal.revealed {
        opacity: 1;
        transform: translateY(0);
    }
</style>
