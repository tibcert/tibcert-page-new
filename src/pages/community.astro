---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/common/PageHeader.astro";
import SectionHeader from "../components/common/SectionHeader.astro";
import ServicesPreview from "../components/landing/ServicesPreview.astro";
import ToolsAndResources from "../components/landing/ToolsAndResources.astro";

const description =
    "The TibCERT Community Services Program, supports over 50 TibCERT member organizations with the following services:";
---

<Layout title="Resources | TibCERT" description={description}>
    <main class="pt-32 pb-24 relative overflow-hidden bg-brand-bg min-h-screen">
        <!-- Page Heading (Same style as about page) -->
        <div class="container mx-auto px-4 pb-16 pt-8">
            <PageHeader
                eyebrow=""
                title="COMMUNITY"
                titleAccent=""
                description={description}
            />
            <!-- Services Grid (Moved from home page) -->
            <ServicesPreview
                hideHeader={true}
                class="pb-16 bg-brand-void relative overflow-hidden reveal"
            />
        </div>

        <ToolsAndResources />
    </main>
</Layout>

<style>
    .reveal {
        opacity: 0;
        transform: translateY(20px);
        transition: all 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .reveal.revealed {
        opacity: 1;
        transform: translateY(0);
    }
</style>
