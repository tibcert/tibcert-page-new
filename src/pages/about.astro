---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import Team from "../components/landing/Team.astro";
import TLPSection from "../components/landing/TLPSection.astro";
import PageHeader from "../components/common/PageHeader.astro";

const description =
    "The Tibetan Computer Emergency Readiness Team (TibCERT) is a coalition-based structure for reducing and mitigating online threats in the Tibetan community, as well expanding Tibetans’ technical research capacity on threats in the diaspora and surveillance and censorship inside Tibet, ultimately ensuring greater online freedom and security for Tibetan society as a whole.";
---

<Layout title="About TibCERT" description={description}>
    <main class="pt-32 pb-24 relative overflow-hidden bg-brand-bg min-h-screen">
        <div class="container mx-auto px-4 pb-12">
            <PageHeader
                eyebrow=""
                title="ABOUT"
                titleAccent=""
                description={description}
            >
                <!-- Right: Mission Points (List Style) -->
                <div slot="right" class="space-y-6">
                    {
                        [
                            {
                                id: "COLLAB_01",
                                title: "Long-term Collaboration",
                                desc: "Create and sustain a platform for long term collaboration between stakeholders in the Tibetan community on digital security issues and needs.",
                                icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19a3 3 0 0 0 3-3v-1a3 3 0 0 0-3-3h-2a3 3 0 0 0-3 3v1a3 3 0 0 0 3 3h2Zm-6 0a3 3 0 0 0 3-3v-1a3 3 0 0 0-3-3H7a3 3 0 0 0-3 3v1a3 3 0 0 0 3 3h2Zm6-9a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm-6 0a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" /></svg>`,
                            },
                            {
                                id: "NETWORK_02",
                                title: "Global Network",
                                desc: "Deepen connections and develop a formal process for collaboration between Tibetans and global malware and cybersecurity researchers to ensure mutually beneficial sharing.",
                                icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0 0c2.5-2.4 4-5.2 4-8.5A8.9 8.9 0 0 0 12 3a8.9 8.9 0 0 0-4 9.5c0 3.3 1.5 6.1 4 8.5Zm0 0V3" /></svg>`,
                            },
                            {
                                id: "RESOURCES_03",
                                title: "Resource Mobilization",
                                desc: "Increase the resources available to Tibetans to defend against and mitigate online attacks by regularly publicizing information and recommendations on threats facing the community.",
                                icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M4 19h16M7 15v4m5-6v10m5-8v8" /></svg>`,
                            },
                            {
                                id: "FREEDOM_04",
                                title: "Censorship / Circumvention",
                                desc: "Help Tibetans in Tibet circumvent censorship and surveillance by providing regular, detailed information and analysis, as well as potential solutions.",
                                icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3l7 3v5c0 4.2-2.6 7.8-7 10-4.4-2.2-7-5.8-7-10V6l7-3Zm0 5v5" /></svg>`,
                            },
                        ].map((m) => (
                            <div class="flex items-start gap-4">
                                <div class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center text-brand-red">
                                    <span
                                        aria-hidden="true"
                                        set:html={m.icon}
                                    />
                                </div>
                                <div class="min-w-0">
                                    <h4 class="text-sm font-bold text-brand-text mb-1 uppercase tracking-tight">
                                        {m.title}
                                    </h4>
                                    <p class="text-sm leading-relaxed font-light text-brand-muted">
                                        {m.desc}
                                    </p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </PageHeader>
            <Team />
            <TLPSection />
        </div>
        <!-- Main Content Section: Two Columns -->
    </main>
</Layout>
