---
import Layout from "../layouts/Layout.astro";
import SectionDivider from "../components/common/SectionDivider.astro";
import ServicesPreview from "../components/landing/ServicesPreview.astro";
---

<Layout title="Services // Capabilities">
    <main class="pt-32 pb-24 relative overflow-hidden bg-brand-bg min-h-screen">
        <!-- Premium Radial Glow -->
        <div
            class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[800px] bg-[radial-gradient(circle_at_50%_-20%,rgba(220,38,38,0.15),transparent_70%)] pointer-events-none"
        >
        </div>

        <!-- Background Grid -->
        <div
            class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.01)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.01)_1px,transparent_1px)] bg-[size:60px_60px] [mask-image:radial-gradient(ellipse_at_center,black,transparent_90%)] -z-10 opacity-[0.05]"
        >
        </div>

        <!-- Page Heading (Same style as about page) -->
        <div class="container mx-auto px-6 relative z-10 pb-16 pt-8">
            <div class="max-w-7xl mx-auto">
                <div class="reveal relative max-w-4xl">
                    <div class="absolute -top-12 -left-12 w-16 h-16 border-t border-l border-brand-red/20"></div>
                    <span class="font-mono text-[10px] text-brand-red tracking-[0.4em] mb-4 block uppercase opacity-60">TibCERT Capabilities //</span>
                    <h1 class="text-5xl md:text-8xl font-black mb-6 text-brand-text leading-none uppercase tracking-tighter italic">
                        Our <span class="text-brand-red">Services</span>
                    </h1>
                    <SectionDivider class="text-brand-red w-48 mb-8" />
                    <p class="text-base md:text-lg text-brand-muted leading-relaxed font-light max-w-2xl">
                        Tailored cybersecurity services, intensive training programs, and direct incident response capabilities that help Tibetan and Tibet Support organizations build digital resilience.
                    </p>
                </div>
            </div>
        </div>

        <!-- Services Grid (Moved from home page) -->
        <ServicesPreview hideHeader={true} class="pb-16 bg-brand-void relative overflow-hidden reveal" />
    </main>
</Layout>

<style>
    .reveal {
        opacity: 0;
        transform: translateY(20px);
        transition: all 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .reveal.revealed {
        opacity: 1;
        transform: translateY(0);
    }
</style>
