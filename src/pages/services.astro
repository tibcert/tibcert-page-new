---
import Layout from "../layouts/Layout.astro";
import SectionDivider from "../components/common/SectionDivider.astro";
import SectionHeader from "../components/common/SectionHeader.astro";

const trainings = [
    {
        id: "training-2hr",
        duration: "2 Hours",
        title: "Digital Hygiene Workshop",
        subtitle: "Introductory & Interactive",
        description: "Introductory digital security practices combined with collaborative team-building exercises. Ideal for quick check-ins and raising general baseline awareness.",
        details: ["Basic digital security practices", "Team building activities", "Interactive workshop format"]
    },
    {
        id: "training-1day",
        duration: "1 Day",
        title: "Digital Hygiene Training",
        subtitle: "Behavioral & Foundational",
        description: "Focuses on foundational capacity building and digital hygiene best practices. Designed to be accessible and non-technical, focusing primarily on digital habits and behavioral security.",
        details: ["Behavioral security habits", "Best practices definition", "Non-technical accessibility"]
    },
    {
        id: "training-2day",
        duration: "2 Days",
        title: "Organizational DigiSec Training",
        subtitle: "Custom & Integrated",
        description: "Customized training modules based on the organization's unique structure. Curated specifically for your organization, integrating various security aspects and workflows into your active environment.",
        details: ["Organization-specific modules", "Workflow integration", "Tailored security guidelines"]
    },
    {
        id: "training-3day",
        duration: "3 Days",
        title: "HRDs & CSOs Security Program",
        subtitle: "Strategic & Applied Threat Modeling",
        description: "Specifically created for Human Rights Defenders (HRDs) and Civil Society Organizations (CSOs). Covers digital hygiene, advanced threat modeling, and includes custom add-ons to build a personalized roadmap/digital security workplan.",
        details: ["Human Rights Defenders focus", "Threat modeling exercises", "Personalized digital security workplan"]
    },
    {
        id: "training-360",
        duration: "360° Audit",
        title: "Audit & Policy Development",
        subtitle: "Comprehensive Governance",
        description: "An end-to-end security review. We audit policies, practices, systems, and access credentials. Following the audit, we develop and build new security policies, train your team to implement them, and conduct a 6-month review checkup.",
        details: ["System and access audit", "Policy creation & implementation", "6-month follow-up review"]
    },
    {
        id: "training-tft",
        duration: "Trainers Program",
        title: "T for T (Training for Trainers)",
        subtitle: "Capacity Scaling",
        description: "Empowering organizational leaders and IT admins with the skills, resources, and pedagogical knowledge to train others. Scales cybersecurity capability internally and builds long-term organizational resilience.",
        details: ["Train the trainer curriculum", "Resource packs & guides", "Internal teaching strategies"]
    }
];

const modules = [
    {
        id: "module-ai",
        title: "AI Policy Development",
        description: "Understand the risks and advantages of using AI platforms. Develop organizational policies to handle automated tools securely while protecting intellectual property."
    },
    {
        id: "module-mdm",
        title: "MDM Training",
        description: "Mobile Device Management training for system admins. Configure, deploy, and monitor organizational devices securely to prevent data leakage and remote compromises."
    },
    {
        id: "module-social",
        title: "Social Media Advocacy",
        description: "Best security practices for digital advocates. Protect brand accounts, handle coordinated attacks, secure access tokens, and analyze metrics without compromising privacy."
    }
];

const movementBuilding = {
    id: "movement-building",
    duration: "1 Week Intensive",
    title: "Movement Building Training",
    description: "A weeklong intensive program focusing on how to build a resilient movement based on the learned experiences of the Tibetan movement. Using technology securely, building robust communities, establishing capacity, and scaling operational knowledge globally.",
    highlights: [
        "Leveraging technology for safe mobilization",
        "Community & capacity building strategies",
        "Knowledge scaling & secure institutional memory"
    ]
};

const coreServices = [
    {
        id: "core-secured",
        title: "“Secured by TibCERT”",
        description: "A comprehensive support framework to secure organization infrastructure and critical workflows.",
        items: [
            "Securing public facing interfaces including websites, social media, and web servers.",
            "Deploying advanced endpoint detection tools (EDR) across organization devices.",
            "Review and development of customized organizational digital security policy.",
            "Interactive training and long-term capacity building for the entire internal team."
        ]
    },
    {
        id: "core-kiosk",
        title: "Digital Security Kiosk",
        subtitle: "1-3 Day Events",
        description: "On-site and temporary security support desk deployed directly at your workshops, campaigns, or conferences.",
        items: [
            "Providing live digital security helpdesk and support services during the event.",
            "Forensics and in-depth analysis of devices for threats, malware, and configuration issues.",
            "Dedicated on-site digital security support for organizers and key speakers.",
            "Raising awareness around digital security issues identified specifically for the event context."
        ]
    }
];
---

<Layout title="Services // Capabilities">
    <main class="pt-32 pb-24 relative overflow-hidden bg-brand-bg min-h-screen">
        <!-- Premium Radial Glow -->
        <div
            class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[800px] bg-[radial-gradient(circle_at_50%_-20%,rgba(220,38,38,0.15),transparent_70%)] pointer-events-none"
        >
        </div>

        <!-- Background Grid -->
        <div
            class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.01)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.01)_1px,transparent_1px)] bg-[size:60px_60px] [mask-image:radial-gradient(ellipse_at_center,black,transparent_90%)] -z-10 opacity-[0.05]"
        >
        </div>

        <div class="container mx-auto px-6 relative z-10">
            <div class="max-w-7xl mx-auto">
                <!-- Header Section -->
                <div class="max-w-4xl mb-24 reveal relative">
                    <!-- Technical Brackets -->
                    <div
                        class="absolute -top-8 -left-8 w-12 h-12 border-t border-l border-brand-red/20 uppercase"
                    >
                    </div>

                    <span
                        class="font-mono text-[10px] text-brand-red tracking-[0.4em] mb-4 block uppercase opacity-60"
                        >SERVICES // CAPABILITIES</span
                    >
                    <h1
                        class="text-5xl md:text-8xl font-black mb-6 text-brand-text leading-none uppercase tracking-tighter italic"
                    >
                        Our <span class="text-brand-red">Services</span>
                    </h1>
                    <SectionDivider class="text-brand-red w-48 mb-8" />

                    <p class="text-base md:text-lg text-brand-muted leading-relaxed font-light">
                        TIBCERT provides specialized digital security trainings, capacity building, 
                        policy development, and tactical support tailored to empower Tibetan civil society, 
                        organizations, and human rights defenders inside the digital frontier.
                    </p>
                </div>

                <!-- Digital Security Trainings -->
                <div class="mb-28 reveal" id="trainings-section">
                    <div class="mb-12">
                        <SectionHeader
                            eyebrow="Part_01 // Training Programs"
                            title="Digital Security"
                            titleAccent="Trainings"
                            description="Modular, behavior-centric, and technical educational workshops structured around organizational scale and user risk profiles."
                        />
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                        {
                            trainings.map((training) => (
                                <div 
                                    id={training.id}
                                    class="group relative bg-brand-surface/[0.03] hover:bg-brand-surface/[0.07] border border-brand-text/5 hover:border-brand-red/30 p-8 transition-all duration-500 flex flex-col justify-between"
                                >
                                    <!-- High-tech Corner Accents -->
                                    <div class="absolute top-0 left-0 w-2 h-2 border-t border-l border-brand-text/10 group-hover:border-brand-red/40 transition-colors"></div>
                                    <div class="absolute bottom-0 right-0 w-2 h-2 border-b border-r border-brand-text/10 group-hover:border-brand-red/40 transition-colors"></div>
                                    
                                    <div>
                                        <!-- Duration Badge -->
                                        <div class="flex justify-between items-center mb-6">
                                            <span class="font-mono text-[9px] text-brand-red bg-brand-red/5 border border-brand-red/20 px-2.5 py-0.5 tracking-wider uppercase font-semibold">
                                                {training.duration}
                                            </span>
                                            <span class="font-mono text-[9px] text-brand-muted/40 uppercase tracking-widest">
                                                [ TRAINING ]
                                            </span>
                                        </div>

                                        <!-- Card Header -->
                                        <h3 class="text-xl font-black text-brand-text mb-1 uppercase tracking-tight italic group-hover:text-brand-red transition-colors">
                                            {training.title}
                                        </h3>
                                        <span class="font-mono text-[9px] text-brand-red/70 uppercase tracking-[0.2em] mb-4 block">
                                            {training.subtitle}
                                        </span>

                                        <p class="text-sm text-brand-muted font-light leading-relaxed mb-6">
                                            {training.description}
                                        </p>
                                    </div>

                                    <!-- Technical Details List -->
                                    <ul class="border-t border-brand-text/5 pt-4 space-y-2">
                                        {training.details.map((detail) => (
                                            <li class="flex items-center gap-2 text-[10px] font-mono text-brand-muted/70">
                                                <span class="w-1 h-1 bg-brand-red shrink-0" />
                                                <span class="uppercase tracking-wider">{detail}</span>
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            ))
                        }
                    </div>
                </div>

                <!-- Additional Security Modules -->
                <div class="mb-28 reveal" id="modules-section">
                    <div class="mb-12">
                        <SectionHeader
                            eyebrow="Part_02 // Modules"
                            title="Additional"
                            titleAccent="Modules"
                            description="Specialized add-on courses designed to integrate with larger training packages or run as standalone technical modules."
                        />
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                        {
                            modules.map((mod) => (
                                <div 
                                    id={mod.id}
                                    class="group bg-brand-void/40 border border-brand-text/5 hover:border-brand-red/20 p-8 transition-all duration-300 relative"
                                >
                                    <div class="absolute top-0 right-0 w-2 h-2 border-t border-r border-brand-text/10 group-hover:border-brand-red/35 transition-colors"></div>
                                    <div class="absolute bottom-0 left-0 w-2 h-2 border-b border-l border-brand-text/10 group-hover:border-brand-red/35 transition-colors"></div>

                                    <span class="font-mono text-[8px] text-brand-red tracking-widest uppercase block mb-3 opacity-60">
                                        // MODULE_ADDON
                                    </span>
                                    <h3 class="text-lg font-black text-brand-text mb-3 uppercase tracking-tight italic">
                                        {mod.title}
                                    </h3>
                                    <p class="text-xs md:text-sm text-brand-muted font-light leading-relaxed">
                                        {mod.description}
                                    </p>
                                </div>
                            ))
                        }
                    </div>
                </div>

                <!-- Movement Building Segment -->
                <div class="mb-28 reveal" id="movement-section">
                    <div 
                        id={movementBuilding.id}
                        class="relative overflow-hidden bg-brand-surface/[0.02] border border-brand-text/5 p-8 md:p-12"
                    >
                        <!-- High-tech tech grid backdrop & border glow -->
                        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(220,38,38,0.05),transparent_60%)] pointer-events-none"></div>
                        <div class="absolute top-0 left-0 w-3 h-3 border-t border-l border-brand-red/30"></div>
                        <div class="absolute bottom-0 right-0 w-3 h-3 border-b border-r border-brand-red/30"></div>

                        <div class="grid lg:grid-cols-12 gap-8 items-center relative z-10">
                            <div class="lg:col-span-7">
                                <div class="flex items-center gap-3 mb-4">
                                    <span class="font-mono text-[9px] text-brand-red bg-brand-red/10 border border-brand-red/30 px-3 py-0.5 tracking-wider uppercase font-semibold">
                                        {movementBuilding.duration}
                                    </span>
                                    <span class="font-mono text-[9px] text-brand-muted/40 uppercase tracking-widest">// SPECIALIZED_SYLLABUS</span>
                                </div>

                                <h2 class="text-3xl md:text-4xl font-black text-brand-text mb-4 uppercase tracking-tighter italic">
                                    {movementBuilding.title}
                                </h2>
                                <p class="text-brand-muted text-sm md:text-base font-light leading-relaxed mb-6">
                                    {movementBuilding.description}
                                </p>
                            </div>

                            <div class="lg:col-span-5 lg:pl-8">
                                <div class="bg-brand-void/50 border border-brand-text/5 p-6 relative">
                                    <span class="font-mono text-[9px] text-brand-red uppercase tracking-wider mb-4 block">Key Focus Areas:</span>
                                    <ul class="space-y-3 font-mono text-[10px] text-brand-muted">
                                        {movementBuilding.highlights.map((highlight) => (
                                            <li class="flex items-start gap-2.5">
                                                <span class="text-brand-red font-semibold shrink-0">&gt;</span>
                                                <span class="uppercase tracking-wider">{highlight}</span>
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TibCERT Services -->
                <div class="reveal" id="tibcert-services-section">
                    <div class="mb-12">
                        <SectionHeader
                            eyebrow="Part_03 // Tactical Operations"
                            title="TibCERT Core"
                            titleAccent="Services"
                            description="Direct threat mitigation, security kiosks, infrastructure hardening, and real-time response capabilities for community entities."
                        />
                    </div>

                    <div class="grid lg:grid-cols-2 gap-8 items-stretch">
                        {
                            coreServices.map((service) => (
                                <div 
                                    id={service.id}
                                    class="group bg-brand-surface/[0.02] border border-brand-text/5 hover:border-brand-red/30 p-8 md:p-10 transition-all duration-500 flex flex-col justify-between relative"
                                >
                                    <div class="absolute top-0 left-0 w-3 h-3 border-t border-l border-brand-text/10 group-hover:border-brand-red/45 transition-colors"></div>
                                    <div class="absolute bottom-0 right-0 w-3 h-3 border-b border-r border-brand-text/10 group-hover:border-brand-red/45 transition-colors"></div>

                                    <div>
                                        <div class="flex justify-between items-center mb-6">
                                            <span class="font-mono text-[10px] text-brand-red tracking-[0.2em] uppercase font-bold">
                                                // SECURE_PROTOCOL
                                            </span>
                                            {service.subtitle && (
                                                <span class="font-mono text-[9px] text-brand-muted/50 border border-brand-text/10 px-2 py-0.5 uppercase tracking-wider">
                                                    {service.subtitle}
                                                </span>
                                            )}
                                        </div>

                                        <h3 class="text-2xl md:text-3xl font-black text-brand-text mb-4 uppercase tracking-tight italic group-hover:text-brand-red transition-colors">
                                            {service.title}
                                        </h3>
                                        <p class="text-sm text-brand-muted font-light leading-relaxed mb-8">
                                            {service.description}
                                        </p>
                                    </div>

                                    <ul class="space-y-4 border-t border-brand-text/5 pt-6">
                                        {service.items.map((item) => (
                                            <li class="flex items-start gap-3 text-xs md:text-sm text-brand-muted font-light leading-relaxed">
                                                <span class="w-1.5 h-1.5 bg-brand-red shrink-0 mt-2" />
                                                <span>{item}</span>
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            ))
                        }
                    </div>
                </div>

            </div>
        </div>
    </main>
</Layout>

<style>
    .reveal {
        opacity: 0;
        transform: translateY(20px);
        transition: all 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .reveal.revealed {
        opacity: 1;
        transform: translateY(0);
    }
</style>
