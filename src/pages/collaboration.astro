---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/common/PageHeader.astro";
import SectionHeader from "../components/common/SectionHeader.astro";

const pillars = [
    {
        id: "THREAT_INTEL",
        title: "Threat intelligence sharing",
        desc: "Exchanging telemetry and threat data with international partners to jointly track cyber espionage campaigns targeting Tibetan diaspora community.",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>`,
    },
    {
        id: "",
        title: "Capacity building & technical expertise sharing",
        desc: "Partnering with trusted organizations to deploy and build in-house technical infrastructures, strengthening our long-term community resilience.",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>`,
    },
    {
        id: "",
        title: "Collaborative research & joint reporting",
        desc: "Working together with research partners to co-publish investigative reports to amplify the digital transnational repression.",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>`,
    },
    {
        id: "",
        title: "Rapid Incident Response Coordination",
        desc: "Working with our partners to rapidly respond to  incidents affecting organizations and removing threats before they cause further damage. ",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`,
    },
];

const networks = [
    {
        name: "Security Research Labs",
        type: "Malware Analysis Partners",
        focus: "Analyzing spyware and zero-days targeting human rights defenders.",
    },
    {
        name: "Digital Rights Coalitions",
        type: "Advocacy & Support Networks",
        focus: "Coordinating response to internet censorship and diaspora surveillance.",
    },
    {
        name: "Sister CERTs & CSIRTs",
        type: "Emergency Coordination",
        focus: "Sharing security intelligence and coordinating cross-border take-downs.",
    },
];
---

<Layout title="Collaboration | TIBCERT">
    <main class="pt-32 pb-24 relative overflow-hidden bg-brand-bg min-h-screen">
        <div class="container mx-auto px-4 pb-20">
            <PageHeader
                eyebrow=""
                title="COLLABORATION"
                titleAccent=""
                description="Through TibCERT’s long term collaborative initiatives, we believe collective defence is our strongest safeguard. By partnering with international cybersecurity researchers, Human rights organizations, and digital security experts, we exchange vital threat intelligence to protect the Tibetan community from persistent and targeted digital transnational repression. "
            >
                <div slot="right" class="space-y-6">
                    {
                        pillars.map((m) => (
                            <div class="flex items-start gap-4    transition-all rounded-sm">
                                <div class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center text-brand-red">
                                    <span
                                        aria-hidden="true"
                                        set:html={m.icon}
                                    />
                                </div>
                                <div class="min-w-0">
                                    <h4 class="text-sm font-bold text-brand-text mb-1 uppercase tracking-tight font-mono">
                                        {m.title}
                                    </h4>
                                    <p class="text-sm leading-relaxed font-light text-brand-muted">
                                        {m.desc}
                                    </p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </PageHeader>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xl">
                <p
                    class="bg-brand-void/50 border border-brand-text/5 p-8 relative group overflow-hidden transition-all duration-300 hover:border-brand-red/35 flex flex-col justify-between h-full"
                >
                    No single organization can track every threat actor. A
                    shared intelligence network means gaps in one group’s
                    visibility are covered by others creating a more complete
                    picture of the threat landscape.
                </p>
                <p
                    class="bg-brand-void/50 border border-brand-text/5 p-8 relative group overflow-hidden transition-all duration-300 hover:border-brand-red/35 flex flex-col justify-between h-full"
                >
                    Access to shared intelligence means earlier detection of
                    threat campaigns and allowing us a faster and more
                    coordinated response to mitigate threat and risk.
                </p>
            </div>
            <!-- Partners Network Section -->
            <div class="reveal mt-16 pt-16 border-t border-brand-surface">
                <div class="mb-12 grid grid-cols-2 gap-2">
                    <SectionHeader
                        eyebrow=""
                        title="Our Partner"
                        titleAccent="Networks"
                        description="TibCERT currently collaborates with researcher, threat intelligence analyst and cybersecurity firms working to protect Tibetan diaspora from targeted digital threats. Given the sensitive nature of our work, the long-term trust required to sustain these collaborations, and our adherence to the TrafficLight Protocol(TLP) for information sharing, we do not publicly disclose the identities of our partners.  This confidentiality protects both our partners and communities we serve. "
                    />
                    <div
                        class="text-white text-lg text-brand-muted mt-24 bg-brand-void/50 border border-brand-text/5 p-8 relative group overflow-hidden transition-all duration-300 hover:border-brand-red/35 font-light"
                    >
                        We currently collaborate with researchers, threat
                        intelligence analysts, and cybersecurity firms working
                        to protect the Tibetan diaspora from targeted digital
                        threats. Due to the sensitive nature of our work, the
                        long-term trust required to sustain these
                        collaborations, and our adherence to the Traffic Light
                        Protocol (TLP) for information sharing, we do not
                        publicly disclose the identities of our partners. This
                        confidentiality protects both our partners and the
                        communities we serve.
                    </div>
                </div>

                <!-- <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    {
                        networks.map((net, index) => (
                            <div class="bg-brand-void/50 border border-brand-text/5 p-8 relative group overflow-hidden transition-all duration-300 hover:border-brand-red/35 flex flex-col justify-between h-full">
                                <div class="absolute top-0 right-0 w-3 h-3 border-t border-r border-brand-text/10 group-hover:border-brand-red/40 transition-colors" />
                                <div class="absolute bottom-0 left-0 w-3 h-3 border-b border-l border-brand-text/10 group-hover:border-brand-red/40 transition-colors" />

                                <div>
                                    <h3 class="text-xl font-black text-brand-text leading-tight mb-2 uppercase tracking-tight italic">
                                        {net.name}
                                    </h3>
                                    <span class="font-mono text-[10px] text-brand-muted uppercase tracking-wider block mb-4">
                                        {net.type}
                                    </span>
                                    <p class="text-sm text-brand-muted leading-relaxed font-light">
                                        {net.focus}
                                    </p>
                                </div>
                            </div>
                        ))
                    }
                </div> -->
            </div>

            <!-- Call to Action -->
            <div
                class="reveal bg-brand-void/40 border border-brand-red/20 p-8 md:p-12 rounded-sm text-center mt-24 relative overflow-hidden"
            >
                <div
                    class="absolute -right-24 -top-24 w-48 h-48 bg-brand-red/5 rounded-full blur-3xl"
                >
                </div>
                <h3
                    class="text-2xl md:text-3xl font-black uppercase italic tracking-tight text-brand-text mb-4"
                >
                    Join Our <span class="text-brand-red"
                        >collaborative effort</span
                    >
                </h3>
                <p
                    class="text-brand-muted text-base max-w-5xl mx-auto mb-8 font-light"
                >
                    If you are a researcher, threat intelligence analyst, or
                    cybersecurity firm interested in contributing your expertise
                    or sharing information that could support our mission, we
                    welcome you to reach out . Whether through data sharing ,
                    joint investigations, or technical collaboration. We're
                    always open to building new trusted relationships that
                    strengthen our collective defense.
                </p>
                <a
                    href="/contact"
                    class="inline-flex bg-brand-red hover:bg-[#d13d25] text-white font-mono text-xs uppercase tracking-[0.2em] px-6 py-3 rounded-sm transition-all shadow-lg shadow-brand-red/10"
                >
                    [ CONTACT_SECURE_DESK ]
                </a>
            </div>
        </div>
    </main>
</Layout>
