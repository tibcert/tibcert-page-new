---
const navItems = [
    { name: "Home", href: "/" },
    // { name: "Response Hub", href: "/response-hub" },
    // { name: "Blog", href: "/blog" },
    { name: "Resources", href: "/resources" },
    {
        name: "Services",
        href: "/services",
        dropdown: [
            { name: "Standard Services", href: "/services" },
            { name: "Premium Services", href: "/paid-services" },
        ],
    },
    { name: "About", href: "/about" },
    { name: "Contact", href: "/contact" },
];

const currentPath = Astro.url.pathname;
const normalizePath = (path: string) =>
    path === "/" ? "/" : path.replace(/\/+$/, "");
const isActiveLink = (href: string) => {
    const normalizedCurrentPath = normalizePath(currentPath);
    const normalizedHref = normalizePath(href);

    if (normalizedHref === "/") {
        return normalizedCurrentPath === "/";
    }

    return (
        normalizedCurrentPath === normalizedHref ||
        normalizedCurrentPath.startsWith(`${normalizedHref}/`)
    );
};

import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<header
    class="bg-brand-void/80 backdrop-blur-md border-b border-brand-surface sticky top-0 z-50"
>
    <nav class="container mx-auto px-4 h-16 flex items-center justify-between">
        <!-- Logo -->
        <a href="/" class="block" aria-label="TIBCERT">
            <Logo class="h-6 w-auto text-brand-text" />
        </a>

        <!-- Desktop Nav -->
        <ul class="hidden md:flex items-center gap-8">
            {
                navItems.map((item) => {
                    const active = isActiveLink(item.href);

                    if (item.dropdown) {
                        return (
                            <li class="relative group py-2">
                                <a
                                    href={item.href}
                                    aria-current={active ? "page" : undefined}
                                    class={`text-sm font-medium transition-colors flex items-center gap-1 py-1 ${
                                        active
                                            ? "text-brand-red"
                                            : "text-brand-text hover:text-brand-red"
                                    }`}
                                >
                                    {item.name}
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        viewBox="0 0 20 20"
                                        fill="currentColor"
                                        class="w-3.5 h-3.5 opacity-60 group-hover:rotate-180 transition-transform duration-300"
                                    >
                                        <path
                                            fill-rule="evenodd"
                                            d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
                                            clip-rule="evenodd"
                                        />
                                    </svg>
                                </a>
                                <div class="absolute top-full left-0 mt-1 w-48 bg-brand-void/95 border border-brand-text/10 py-2 rounded-sm shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50 backdrop-blur-md">
                                    {item.dropdown.map((subItem) => {
                                        const subActive = isActiveLink(
                                            subItem.href,
                                        );
                                        return (
                                            <a
                                                href={subItem.href}
                                                class={`block px-4 py-2 text-xs font-mono tracking-wider uppercase transition-colors ${
                                                    subActive
                                                        ? "text-brand-red bg-brand-red/5"
                                                        : "text-brand-text hover:text-brand-red hover:bg-white/5"
                                                }`}
                                            >
                                                // {subItem.name}
                                            </a>
                                        );
                                    })}
                                </div>
                            </li>
                        );
                    }

                    return (
                        <li>
                            <a
                                href={item.href}
                                aria-current={active ? "page" : undefined}
                                class={`text-sm font-medium transition-colors ${
                                    active
                                        ? "text-brand-red "
                                        : "text-brand-text hover:text-brand-red"
                                }`}
                            >
                                {item.name}
                            </a>
                        </li>
                    );
                })
            }
        </ul>

        <!-- Actions -->
        <div class="hidden md:flex items-center gap-6">
            <ThemeToggle />
            <a
                href="/contact"
                class="bg-brand-red hover:bg-[#d13d25] text-white font-mono text-[10px] uppercase tracking-[0.2em] px-5 py-2.5 rounded-sm transition-all shadow-lg shadow-brand-red/10 flex items-center gap-2"
            >
                <span
                    class="w-1.5 h-1.5 rounded-full bg-brand-text animate-pulse"
                ></span>
                [ REPORT_INCIDENT ]
            </a>
        </div>

        <!-- Mobile Menu Button (Placeholder) -->
        <button class="md:hidden text-brand-text">
            <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="w-6 h-6"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
            </svg>
        </button>
    </nav>
</header>
