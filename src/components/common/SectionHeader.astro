---
import SectionDivider from "./SectionDivider.astro";

interface Props {
    eyebrow?: string;
    title?: string;
    titleAccent?: string;
    description?: string;
    align?: "left" | "center";
    dividerClass?: string;
    class?: string;
}

const {
    eyebrow = "",
    title = "",
    titleAccent = "",
    description = "",
    align = "left",
    dividerClass = "text-brand-red w-48",
    class: className = "",
} = Astro.props;

const alignment = align === "center" ? "items-center text-center mx-auto" : "";
---

<div class:list={["max-w-4xl", alignment, className]}>
    {eyebrow && (
        <span class="font-mono text-[10px] text-brand-red tracking-[0.4em] mb-2 block uppercase opacity-60">
            {eyebrow}
        </span>
    )}

    {title && (
        <h2 class:list={["text-4xl md:text-5xl font-black mb-3 uppercase tracking-tight italic", align === "center" ? "mx-auto" : ""]}>
            {title}
            {titleAccent && <span class="text-brand-red">{titleAccent}</span>}
        </h2>
    )}

    <SectionDivider class:list={[dividerClass, align === "center" ? "mx-auto" : ""]} />

    {description && (
        <p class:list={["text-base md:text-lg text-brand-muted leading-relaxed font-light max-w-2xl mt-4", align === "center" ? "mx-auto" : ""]}>
            {description}
        </p>
    )}
</div>
