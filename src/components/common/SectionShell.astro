---
interface Props {
    id?: string;
    class?: string;
    containerClass?: string;
    contentClass?: string;
}

const {
    id,
    class: className = "",
    containerClass = "mx-auto px-6",
    contentClass = "max-w-7xl mx-auto",
} = Astro.props;
---

<section id={id} class:list={["relative overflow-hidden", className]}>
    <div class:list={["container", containerClass, "relative z-10"]}>
        <div class={contentClass}>
            <slot />
        </div>
    </div>
</section>
