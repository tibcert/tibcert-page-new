---
import SectionDivider from "./SectionDivider.astro";

interface Props {
    eyebrow?: string;
    title: string;
    titleAccent?: string;
    description?: string;
}

const { eyebrow, title, titleAccent, description } = Astro.props;
const hasRightColumn = Astro.slots.has("right");
---

<!-- Premium Radial Glow -->
<div
    class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[800px] bg-[radial-gradient(circle_at_50%_-20%,rgba(220,38,38,0.15),transparent_70%)] pointer-events-none"
>
</div>

<!-- Background Grid -->
<div
    class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.01)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.01)_1px,transparent_1px)] bg-[size:60px_60px] [mask-image:radial-gradient(ellipse_at_center,black,transparent_90%)] -z-10 opacity-[0.05] pointer-events-none"
>
</div>

{hasRightColumn ? (
    <div class="grid lg:grid-cols-[1.05fr_0.95fr] gap-12 items-start mb-24 w-full">
        <div class="reveal relative max-w-4xl pt-4">
            <!-- Technical Brackets -->
            <div class="absolute -top-8 -left-8 w-16 h-16 border-t border-l border-brand-red/20 pointer-events-none"></div>

            {eyebrow && (
                <span class="font-mono text-[10px] text-brand-red tracking-[0.4em] mb-4 block uppercase opacity-60">
                    {eyebrow}
                </span>
            )}
            
            <h1 class="text-3xl md:text-6xl font-black mb-6 text-brand-text leading-none  tracking-tighter italic">
                {title} {titleAccent && <span class="text-brand-red">{titleAccent}</span>}
            </h1>
            
            <SectionDivider class="text-brand-red w-48 mb-8" />
            
            {description ? (
                <p class="text-base md:text-lg text-brand-muted leading-relaxed font-light max-w-2xl">
                    {description}
                </p>
            ) : (
                <div class="space-y-6 text-base md:text-lg text-brand-muted leading-relaxed font-light max-w-2xl">
                    <slot />
                </div>
            )}
        </div>
        <div class="reveal space-y-6 pt-4" style="animation-delay: 0.2s;">
            <slot name="right" />
        </div>
    </div>
) : (
    <div class="reveal relative max-w-4xl mb-16 pt-4">
        <!-- Technical Brackets -->
        <div class="absolute -top-8 -left-8 w-16 h-16 border-t border-l border-brand-red/20 pointer-events-none"></div>

        {eyebrow && (
            <span class="font-mono text-[10px] text-brand-red tracking-[0.4em] mb-4 block uppercase opacity-60">
                {eyebrow}
            </span>
        )}
        
        <h1 class="text-5xl md:text-7xl font-black mb-6 text-brand-text leading-none tracking-tighter italic">
            {title} {titleAccent && <span class="text-brand-red">{titleAccent}</span>}
        </h1>
        
        <SectionDivider class="text-brand-red w-48 mb-8" />
        
        {description ? (
            <p class="text-base md:text-lg text-brand-muted leading-relaxed font-light max-w-2xl">
                {description}
            </p>
        ) : (
            <div class="space-y-6 text-base md:text-lg text-brand-muted leading-relaxed font-light max-w-2xl">
                <slot />
            </div>
        )}
    </div>
)}
