---
import BackgroundGlow from "../common/BackgroundGlow.astro";
import SectionDivider from "../common/SectionDivider.astro";
import SectionShell from "../common/SectionShell.astro";
import { getLatestSocialPosts } from "../../utils/social-data";

const posts = await getLatestSocialPosts();

const platformIcons = {
    facebook: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>`,
    instagram: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><circle cx="17.5" cy="6.5" r="1.5"/></svg>`,
    x: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M18.5 6.5 13 12l5.5 5.5-1.5 1.5L11.5 13.5 6 19l-1.5-1.5L10.5 12 4.5 6 6 4.5l5.5 5.5L17 4.5z"/></svg>`,
    github: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.42 2.87 8.17 6.84 9.49.5.09.68-.22.68-.48 0-.24-.01-.87-.01-1.71-2.78.61-3.37-1.34-3.37-1.34-.45-1.17-1.11-1.48-1.11-1.48-.91-.62.07-.61.07-.61 1.01.07 1.54 1.04 1.54 1.04.89 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.63-1.33-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02A9.56 9.56 0 0 1 12 6.8c.85.004 1.71.12 2.51.35 1.9-1.29 2.74-1.02 2.74-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.85-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85 0 1.33-.01 2.4-.01 2.72 0 .27.18.58.69.48A10.01 10.01 0 0 0 22 12c0-5.52-4.48-10-10-10Z"/></svg>`
};
---

<SectionShell
    id="social-hub"
    class="pt-20 pb-16 bg-brand-void relative overflow-hidden reveal"
    containerClass="mx-auto px-4"
    contentClass="relative z-10"
>
    <!-- Technical Background -->
    <BackgroundGlow 
        color="fill-brand-red" 
        size="w-[600px] h-[600px]" 
        opacity="opacity-5" 
        class="top-0 -right-48" 
    />
    
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-6 relative">
                <div class="max-w-2xl">
                    <h3 class="text-4xl md:text-5xl font-black text-brand-text mb-3  tracking-tight italic">
                        TibCERT <span class="text-brand-red">SOCIAL MEDIA</span>
                    </h3>
                    <SectionDivider class="text-brand-red w-48 mb-4" />
                    <p class="text-base md:text-lg text-brand-muted leading-relaxed font-light max-w-2xl">
                        Helping to foster a culture of digital security within the Tibetan community  by raising awareness of online threats and encouraging and empowering safer online practices.
                    </p>
                </div>
            <div class="flex items-center gap-4 pb-2 border-b-2 border-brand-red/10">
                <span class="flex h-2 w-2 relative">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-red opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-red"></span>
                </span>
                <span class="font-mono text-[10px] text-brand-text uppercase tracking-widest">REALTIME_SCANNING</span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            {posts.map((post) => (
                <a 
                    href={post.link} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="group relative bg-brand-surface/30 border border-brand-text/10 p-6 flex flex-col h-full hover:border-brand-red/30 transition-all duration-500 overflow-hidden"
                >
                    <!-- Animated Hover Background -->
                    <div class="absolute inset-0 bg-gradient-to-br from-brand-red/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>

                    <!-- Platform Header -->
                    <div class="flex items-center justify-between mb-6 relative z-10">
                        <div class="flex items-center gap-2">
                            <div class:list={[
                                "w-6 h-6 rounded-sm flex items-center justify-center",
                                post.platform === 'facebook' ? "text-[#1877F2] bg-[#1877F2]/10" : "text-[#E4405F] bg-[#E4405F]/10"
                            ]} set:html={platformIcons[post.platform]}>
                            </div>
                            <span class="font-mono text-[9px] text-brand-text uppercase tracking-[0.2em]">{post.platform}</span>
                        </div>
                        <span class="font-mono text-[9px] text-brand-muted/40 uppercase tracking-widest">{post.date}</span>
                    </div>

                    <!-- Media if available -->
                    {post.imageUrl && (
                        <div class="mb-4 aspect-video overflow-hidden border border-brand-text/5 relative z-10">
                            <img src={post.imageUrl} alt="Social media content" class="w-full h-full object-cover grayscale opacity-50 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-700 scale-105 group-hover:scale-100" />
                        </div>
                    )}

                    <!-- Content -->
                    <p class="text-sm text-brand-muted font-light leading-relaxed mb-6 line-clamp-4 relative z-10 group-hover:text-brand-text transition-colors">
                        {post.content}
                    </p>

                    <!-- Metrics / Footer -->
                    <div class="mt-auto pt-4 border-t border-brand-text/5 flex items-center gap-4 relative z-10">
                        <div class="flex items-center gap-1.5 group/metric ">
                            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-red/40 group-hover/metric:text-brand-red transition-colors"><path d="M7 10v12"></path><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2h0a3.13 3.13 0 0 1 3 3.88Z"></path></svg>
                            <span class="font-mono text-[9px] text-brand-muted">{post.metrics.likes}</span>
                        </div>
                        <div class="flex items-center gap-1.5 group/metric">
                            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-red/40 group-hover/metric:text-brand-red transition-colors"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                            <span class="font-mono text-[9px] text-brand-muted">{post.metrics.comments}</span>
                        </div>
                        {post.metrics.shares !== undefined && (
                            <div class="flex items-center gap-1.5 group/metric">
                                <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-red/40 group-hover/metric:text-brand-red transition-colors"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path><polyline points="16 6 12 2 8 6"></polyline><line x1="12" y1="2" x2="12" y2="15"></line></svg>
                                <span class="font-mono text-[9px] text-brand-muted">{post.metrics.shares}</span>
                            </div>
                        )}
                        <div class="ml-auto w-4 h-4 text-brand-red opacity-0 group-hover:opacity-100 -translate-x-2 group-hover:translate-x-0 transition-all duration-500">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
                        </div>
                    </div>

                    <!-- Corner Accents -->
                    <div class="absolute top-0 right-0 w-8 h-8 pointer-events-none overflow-hidden">
                        <div class="absolute top-0 right-0 w-[141%] h-px bg-brand-red/20 rotate-45 translate-x-1/2 -translate-y-1/2 group-hover:bg-brand-red transition-colors"></div>
                    </div>
                </a>
            ))}
        </div>

        <div class="mt-10 flex justify-center">
            <div class="inline-flex items-center gap-8 px-8 py-3 border border-brand-text/5 rounded-full backdrop-blur-sm">
                <a href="https://facebook.com/tibcert" target="_blank" rel="noopener noreferrer" class="flex h-12 w-12 items-center justify-center rounded-full bg-[#1877F2]/10 border border-[#1877F2]/20 text-[#1877F2] hover:bg-[#1877F2]/20 hover:border-[#1877F2]/40 transition-all duration-300 shadow-lg shadow-[#1877F2]/5 hover:shadow-[#1877F2]/20">
                    <span class="sr-only">Facebook</span>
                    <span class="w-6 h-6 flex items-center justify-center leading-none" set:html={platformIcons.facebook}></span>
                </a>
                <div class="w-px h-4 bg-brand-text/10"></div>
                <a href="https://instagram.com/tibcert" target="_blank" rel="noopener noreferrer" class="flex h-12 w-12 items-center justify-center rounded-full bg-[#E4405F]/10 border border-[#E4405F]/20 text-[#E4405F] hover:bg-[#E4405F]/20 hover:border-[#E4405F]/40 transition-all duration-300 shadow-lg shadow-[#E4405F]/5 hover:shadow-[#E4405F]/20">
                    <span class="sr-only">Instagram</span>
                    <span class="w-6 h-6 flex items-center justify-center leading-none" set:html={platformIcons.instagram}></span>
                </a>
                <div class="w-px h-4 bg-brand-text/10"></div>
                <a href="https://x.com/tibcert" target="_blank" rel="noopener noreferrer" class="flex h-12 w-12 items-center justify-center rounded-full bg-white/10 border border-white/20 text-white hover:bg-white/20 hover:border-white/40 transition-all duration-300 shadow-lg shadow-white/5 hover:shadow-white/20">
                    <span class="sr-only">X</span>
                    <span class="w-6 h-6 flex items-center justify-center leading-none" set:html={platformIcons.x}></span>
                </a>
                <div class="w-px h-4 bg-brand-text/10"></div>
                <a href="https://github.com/tibcert" target="_blank" rel="noopener noreferrer" class="flex h-12 w-12 items-center justify-center rounded-full bg-white/10 border border-white/20 text-white hover:bg-white/20 hover:border-white/40 transition-all duration-300 shadow-lg shadow-white/5 hover:shadow-white/20">
                    <span class="sr-only">GitHub</span>
                    <span class="w-6 h-6 flex items-center justify-center leading-none" set:html={platformIcons.github}></span>
                </a>
            </div>
        </div>
            </div>
        </div>
    </div>
</SectionShell>
