---
import SectionShell from "../common/SectionShell.astro";

const stats = [
    {
        id: "orgs",
        number: "100+",
        label: "Organizations Supported",
        code: "ORG_SUPPORTED",
        sparkPath: "M 10 47.5 C 38 47.5, 38 39, 66 39 C 94 39, 94 28, 122 28 C 150 28, 150 16, 178 16 C 206 16, 206 9, 234 9 C 262 9, 262 5, 290 5"
    },
    {
        id: "incidents",
        number: "700+",
        label: "Incident Response",
        code: "INCIDENT_RESPONSE",
        sparkPath: "M 10 49 C 38 49, 38 40, 66 40 C 94 40, 94 28, 122 28 C 150 28, 150 18.5, 178 18.5 C 206 18.5, 206 9.5, 234 9.5 C 262 9.5, 262 5, 290 5"
    },
    {
        id: "trainings",
        number: "500+",
        label: "Trainings and Workshops",
        code: "TRAINING_WORKSHOPS",
        sparkPath: "M 10 49 C 38 49, 38 40, 66 40 C 94 40, 94 27, 122 27 C 150 27, 150 16, 178 16 C 206 16, 206 9, 234 9 C 262 9, 262 5, 290 5"
    }
];
---

<SectionShell
    class="pt-20 pb-16 border-y border-brand-text/5 bg-brand-red relative overflow-hidden reveal"
    containerClass="mx-auto px-4"
    contentClass="relative z-10"
>
    <!-- Background element -->
    <div class="absolute inset-0 pointer-events-none"></div>

    <!-- Technical Label -->
    <div class="flex items-center justify-center gap-3 mb-6 opacity-40">
        <div class="h-px w-6 bg-white/25"></div>
    </div>

    <div class="relative max-w-4xl mx-auto py-8 px-6 md:px-8 text-center mb-16">
        <!-- Decorative Brackets -->
        <div class="absolute top-0 left-0 w-8 h-8 border-t border-l border-white/20"></div>
        <div class="absolute bottom-0 right-0 w-8 h-8 border-b border-r border-white/20"></div>

        <h2 class="text-4xl md:text-5xl font-black uppercase tracking-tight italic text-white mb-4">
            Collective <span class="text-white/80">Defense</span>
        </h2>
        <p class="text-xl md:text-base text-white/85 max-w-4xl mx-auto  leading-relaxed font-medium">
            Securing digital infrastructure, coordinating incident response operations,<br/> and scaling security capacity to protect Tibetan civil society globally.
        </p>
        <div class="w-full flex justify-center">
				<hr class="w-1/5 border-2 mt-4">
			</div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 md:gap-12 items-center justify-center text-center">
        {stats.map((stat) => (
            <div class="group relative flex flex-col items-center p-6 bg-white/10 border border-white/10 hover:border-white/30 transition-all duration-500 backdrop-blur-sm">
                <!-- Technical Corner Accents for each stat item -->
                <div class="absolute top-0 left-0 w-2 h-2 border-t border-l border-white/20 group-hover:border-white/60 transition-colors"></div>
                <div class="absolute bottom-0 right-0 w-2 h-2 border-b border-r border-white/20 group-hover:border-white/60 transition-colors"></div>

                <!-- Code tag -->
                {/* <span class="font-mono text-[8px] text-white/50 uppercase tracking-widest mb-3 block">
                    // {stat.code}
                </span> */}

                <!-- Giant stat number -->
                <span 
                    class="text-4xl md:text-5xl lg:text-6xl font-black font-mono text-white group-hover:scale-105 transition-transform duration-500 mb-2 select-none tracking-tight block stat-number"
                    data-target={stat.number.replace("+", "")}
                >
                    0+
                </span>

                <!-- Simple, beautiful SVG sparkline trend graph -->
                <div class="w-full max-w-[200px] h-[45px] my-3 relative">
                    <svg viewBox="0 0 300 60" class="w-full h-full overflow-visible">
                        <defs>
                            <linearGradient id={`sparkline-grad-${stat.id}`} x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#ffffff" stop-opacity="0.25" />
                                <stop offset="100%" stop-color="#ffffff" stop-opacity="0" />
                            </linearGradient>
                        </defs>
                        <!-- Sparkline path fill -->
                        <path
                            d={`${stat.sparkPath} L 290 60 L 10 60 Z`}
                            fill={`url(#sparkline-grad-${stat.id})`}
                        />
                        <!-- Sparkline line -->
                        <path
                            d={stat.sparkPath}
                            fill="none"
                            stroke="#ffffff"
                            stroke-width="2.5"
                            class="sparkline-path"
                        />
                        <!-- Pulsing current data point dot -->
                        <circle cx="290" cy="5" r="3.5" fill="#ffffff" />
                        <circle cx="290" cy="5" r="7" fill="#ffffff" fill-opacity="0.3" class="animate-pulse" />
                    </svg>
                </div>

                <!-- Description label -->
                <span class="font-mono text-[9px] md:text-[10px] text-white uppercase tracking-widest font-semibold max-w-[180px] leading-relaxed block">
                    {stat.label}
                </span>
            </div>
        ))}
    </div>
</SectionShell>

<script>
    // Count up animation for stat numbers
    const counters = document.querySelectorAll('.stat-number');
    
    const countUp = (el: HTMLElement) => {
        const target = parseInt(el.getAttribute('data-target') || '0', 10);
        const duration = 1800; // 1.8 seconds
        const startTime = performance.now();
        
        const updateCount = (currentTime: number) => {
            const elapsedTime = currentTime - startTime;
            const progress = Math.min(elapsedTime / duration, 1);
            
            // Easing function: easeOutQuad
            const easeProgress = progress * (2 - progress);
            
            const currentVal = Math.floor(easeProgress * target);
            el.textContent = `${currentVal}+`;
            
            if (progress < 1) {
                requestAnimationFrame(updateCount);
            } else {
                el.textContent = `${target}+`;
            }
        };
        
        requestAnimationFrame(updateCount);
    };

    // Animated drawing for sparkline path on intersection
    const setupSparklines = () => {
        const sparklines = document.querySelectorAll('.sparkline-path');
        sparklines.forEach(line => {
            const path = line as SVGPathElement;
            const length = path.getTotalLength();
            path.style.strokeDasharray = length.toString();
            path.style.strokeDashoffset = length.toString();
            path.style.transition = "stroke-dashoffset 2s cubic-bezier(0.22, 1, 0.36, 1)";
            
            const sparkObserver = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        path.style.strokeDashoffset = "0";
                        sparkObserver.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.1 });
            
            sparkObserver.observe(path);
        });
    };

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                countUp(entry.target as HTMLElement);
                observer.unobserve(entry.target);
            }
        });
    }, { threshold: 0.1 });

    counters.forEach(counter => observer.observe(counter));

    // Support view transitions and page load
    document.addEventListener("astro:page-load", setupSparklines);
    setupSparklines();
</script>
