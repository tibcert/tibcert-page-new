---

<section class="py-20  border-y border-brand-text/5 relative overflow-hidden bg-brand-red">
    <!-- Background glow -->
    <div class="absolute inset-0  from-brand-red/5 via-transparent to-transparent opacity-30 pointer-events-none"></div>
    
    <div class="mx-auto px-4 max-w-6xl relative z-10">
        <div class="text-center">
            <!-- Icon -->
            <div class=" inline-block">
                <img 
                    src="/images/secured-by-tibcert.svg" 
                    alt="Secured by TibCert" 
                    class="w-60  mx-auto"
                />
            </div>
            
            <!-- Label -->
            <span class="font-mono text-[9px] text-brand-red tracking-[0.4em] mb-4 block uppercase opacity-60">SECURITY_CERTIFICATION</span>
            
            <!-- Headline -->
            <!-- <h2 class="text-4xl md:text-5xl font-black text-brand-text mb-6 uppercase tracking-tight italic">
                Secured by <span class="text-brand-red">TibCert</span>
            </h2> -->
            
            <!-- Description -->
            <p class="text-base md:text-2xl text-brand-text leading-relaxed font-light max-w-3xl mx-auto mb-8">
                Securing digital infrastructure, coordinating incident response operations, and scaling security capacity to protect Tibetan civil society globally.
            </p>
            
            <!-- Accent line -->
            <div class="w-16 h-px bg-gradient-to-r from-transparent via-brand-red to-transparent mx-auto"></div>
        </div>
    </div>
</section>