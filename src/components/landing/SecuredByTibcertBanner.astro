---

---

<section
    class="py-20 border-y border-brand-text/5 relative overflow-hidden bg-brand-red reveal filter-overlay"
>
    <!-- Background image watermark -->
    <div
        class="absolute inset-0 bg-cover bg-center opacity-15 pointer-events-none"
        style="background-image: url('/images/meetup1.jpg'); position: absolute !important; z-index: 0 !important; "
    >
    </div>

    <!-- Background glow -->
    <div
        class="absolute inset-0 from-brand-red/5 via-transparent to-transparent opacity-30 pointer-events-none"
    >
    </div>

    <div class="mx-auto px-4 max-w-6xl relative z-10">
        <div class="text-center">
            <!-- Combined CTA container with decorative brackets -->
            <div class="relative max-w-7xl mx-auto py-8 px-6 md:px-8">
                <!-- Decorative Brackets -->
                <div
                    class="absolute top-0 left-0 w-6 h-6 border-t border-l border-white/20"
                >
                </div>
                <div
                    class="absolute bottom-0 right-0 w-6 h-6 border-b border-r border-white/20"
                >
                </div>
                <!-- Icon -->
                <div class="inline-block mb-6">
                    <img
                        src="/images/secured-by-tibcert.png"
                        alt="Secured by TibCert"
                        class="w-60 mx-auto"
                    />
                </div>

                <!-- Description -->
                <p
                    class="text-base md:text-2xl text-brand-text leading-relaxed font-light max-w-5xl mx-auto font-medium"
                >
                    Securing digital infrastructure, coordinating incident
                    response operations, <br class="hidden md:inline" />and
                    scaling security capacity to protect Tibetan civil society
                    globally.
                </p>

                <p
                    class="max-w-xl mx-auto text-lg md:text-base font-light leading-relaxed text-center py-4 text-white/90 mb-6"
                >
                    Don't wait for an incident to happen. Contact TibCERT today
                    for a security assessment.
                </p>

                <div class="w-full flex justify-center mb-6">
                    <hr class="w-16 border-white/20" />
                </div>

                <div class="flex items-center justify-center">
                    <a
                        href="/contact"
                        class="bg-white hover:bg-brand-surface text-brand-red font-mono text-sm tracking-[0.2em] py-4 px-10 rounded-sm transition-all transform hover:-translate-y-1 shadow-2xl shadow-black/20 uppercase inline-block"
                    >
                        [ CONTACT_US ]
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
