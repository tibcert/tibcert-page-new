---
import SectionDivider from "../common/SectionDivider.astro";
import SectionShell from "../common/SectionShell.astro";

interface Props {
    hideHeader?: boolean;
    class?: string;
}

const { hideHeader = false, class: className = "pt-20 pb-16 bg-brand-void relative overflow-hidden reveal" } = Astro.props;

const services = [
    {
        title: "Incident Response",
        description:
            "Provide timely support to investigate, contain, and recover from digital security incidents.",
        image: "/images/landing/incident-response.png",
        span: "lg:col-span-2 lg:row-span-1",
        type: "image",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-brand-red/80 group-hover:text-brand-red transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>`,
    },
    {
        title: "Security Training",
        description: "Deliver practical digital security workshops and digital hygiene education to help individuals and organizations reduce cyber risks.",
        image: "/images/landing/training.png",
        span: "lg:col-span-1 lg:row-span-1",
        type: "image",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-brand-red/80 group-hover:text-brand-red transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>`,
    },
    {
        title: "Infrastructure Audits",
        description: "Assess digital systems and infrastructure to identify security gaps and recommend improvements.",
        image: "/images/landing/audits.png",
        span: "lg:col-span-1 lg:row-span-1",
        type: "image",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-brand-red/80 group-hover:text-brand-red transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>`,
    },
    {
        title: "Priority Response",
        description:
            "24/7 help desk with rapid assistance for high-risk or urgent digital security incidents.",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-brand-red/80 group-hover:text-brand-red transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`,
        span: "lg:col-span-1 lg:row-span-1",
        color: "brand-red",
        type: "icon",
    },
    {
        title: "Capacity Building",
        description:
            "Invitations to strengthen the skills, knowledge, and security practices of organizations and community members",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-brand-red/80 group-hover:text-brand-red transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>`,
        span: "lg:col-span-1 lg:row-span-1",
        color: "brand-amber",
        type: "icon",
    },
    {
        title: "Threat Intelligence",
        description:
            "Share timely information on emerging threats, attack trends, and security risks affecting the community.",
        image: "/images/landing/threat-intel.png",
        span: "lg:col-span-2 lg:row-span-1",
        type: "image",
        icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-brand-red/80 group-hover:text-brand-red transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>`,
    },
];
---

<SectionShell
    class={className}
    containerClass="mx-auto px-4"
    contentClass="relative z-10"
>
    <!-- Sophisticated Background Accents -->
    <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-brand-red/5 blur-[120px] rounded-full -translate-y-1/2 translate-x-1/2"></div>
    <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-brand-amber/5 blur-[100px] rounded-full translate-y-1/2 -translate-x-1/2"></div>

            {!hideHeader && (
                <div class="max-w-4xl mb-8 reveal relative">
                    <!-- Technical Brackets -->
                    <div class="absolute -top-8 -left-8 w-12 h-12 border-t border-l border-brand-red/20 opacity-60"></div>
                    
                    <span class="font-mono text-[10px] text-brand-red tracking-[0.4em] mb-2 block uppercase opacity-60">TibCERT Services //</span>
                    <h2 class="text-4xl md:text-5xl font-black mb-3 text-brand-text leading-tight uppercase tracking-tight italic">
                        Our <span class="text-brand-red">Core</span> Services
                    </h2>
                    <SectionDivider class="text-brand-red w-48 mb-4" />
                    <p class="text-base md:text-lg text-brand-muted leading-relaxed font-light max-w-2xl">
                        Tailored cybersecurity services that help Tibetan and Tibet Support organizations build resilience and safeguard their communities from digital threats. 
                    </p>
                </div>
            )}

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-brand-text/5 border border-brand-text/5">
            {
                services.map((service, index) => (
                    <div class="group relative py-12 px-8 bg-brand-void hover:bg-brand-red/[0.02] transition-all duration-500 overflow-hidden">
                        <!-- Technical Background Pattern -->
                        <div class="absolute top-0 right-0 w-32 h-32 opacity-0 group-hover:opacity-10 transition-opacity duration-700 pointer-events-none">
                            <div class="absolute top-4 right-4 w-12 h-px bg-brand-red"></div>
                            <div class="absolute top-4 right-4 h-12 w-px bg-brand-red"></div>
                        </div>

                        <!-- Scanline and Glow -->
                        <div class="absolute inset-0 bg-[linear-gradient(to_bottom,transparent_0%,rgba(239,72,44,0.05)_50%,transparent_100%)] bg-[length:100%_200%] bg-[position:0_-100%] group-hover:bg-[position:0_100%] transition-all duration-[1500ms] pointer-events-none"></div>
                        
                        <div class="relative z-10 flex flex-col gap-6 h-full">
                            <!-- Technical Header -->
                            <div class="flex flex-col gap-2">
                                <div class="flex justify-between items-start w-full gap-4">
                                    <h3 class="text-2xl font-black text-brand-red group-hover:text-brand-red transition-colors duration-500 tracking-tight">
                                        {service.title}
                                    </h3>
                                    {service.icon && <Fragment set:html={service.icon} />}
                                </div>
                            </div>

                            <!-- Description with Monospace Metadata -->
                            <div class="flex-grow flex flex-col gap-4">
                                <p class="text-brand-muted group-hover:text-brand-text transition-colors duration-500 text-base leading-relaxed font-light">
                                    {service.description}
                                </p>
                               
                            </div>
                        </div>

                        
                    </div>
                ))
            }
            </div>
        </div>
    </div>
</SectionShell>
