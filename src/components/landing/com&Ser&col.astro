---
const cards = [
	{
		label: "Community",
		title: "Community",
		description:
			"Committed to safeguarding the digital space of the communities we serve through protection, awareness, and support needed to stay safe against evolving cyber threats.",
		href: "/community",
	},
	{
		label: "Services",
		title: "Services",
		description:
			"Rapid incident response, tailored security training, and capacity-building programs. Helping organizations move from reactive defense to proactive, sustainable security.",
		href: "/paid-services",
	},
	{
		label: "Collaboration",
		title: "Collaboration",
		description:
			"Collaborating  with international cyber research organizations to investigate targeted attacks, advance threat intelligence and strengthen collective defense worldwide.",
		href: "/collaboration",
	},
];
---

<section class="w-full bg-brand-red">
	<div class="container mx-auto px-4 py-20">
		<div class="max-w-4xl mx-auto mb-12 text-center reveal">
			<h2
				class="text-4xl md:text-5xl font-black uppercase tracking-tight italic text-brand-text"
			>
				What We Do
			</h2>
			<p
				class="mt-4  text-base md:text-lg leading-relaxed max-w-2xl mx-auto text-brand-text"
			>
				Explore how TibCERT supports the Tibetan community with secure
				services, trusted community programs, and collaborative
				partnerships.
			</p>
			<div class="w-full flex justify-center">
				<hr class="w-1/5 border-2 mt-6">
			</div>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-3 gap-6 reveal">
			{
				cards.map((card) => (
					<div class="group relative overflow-hidden bg-brand-surface hover:bg-brand-surface/80 border border-brand-text/5 hover:border-brand-surface/30 p-8 transition-all duration-500 flex flex-col justify-between">
						<div class="absolute top-0 left-0 w-3 h-3 border-t border-l border-brand-text/10 group-hover:border-brand-red/40 transition-colors" />
						
						<h3 class="text-2xl font-black uppercase tracking-tight mb-4 text-brand-red">
							{card.title}
						</h3>
						<p class="text-brand-muted leading-relaxed mb-6">
							{card.description}
						</p>
						{/* <a
							href={card.href}
							class="inline-flex items-center gap-2 text-sm uppercase tracking-[0.2em] text-brand-red font-black hover:text-brand-text transition-colors"
						>
							Explore
							<span>&rarr;</span>
						</a> */}
					</div>
				))
			}
		</div>
	</div>
</section>
