---
const cards = [
	{
		label: "Community",
		title: "Community",
		description:
			"Community-led digital security programs, awareness campaigns, and resilience-building support for Tibetan organizations.",
		href: "/community",
	},
	{
		label: "Services",
		title: "Services",
		description:
			"Specialized cybersecurity services, incident response, and training designed to protect Tibetan organizations and networks.",
		href: "/paid-services",
	},
	{
		label: "Collaboration",
		title: "Collaboration",
		description:
			"Partnerships, research alliances, and joint initiatives that strengthen digital resilience across the Tibetan community.",
		href: "/collaboration",
	},
];
---

<section class="w-full bg-brand-red">
	<div class="container mx-auto px-4 py-20">
		<div class="max-w-4xl mx-auto mb-12 text-center reveal">
			<span
				class="font-mono text-[10px] text-brand-red tracking-[0.4em] uppercase opacity-60 mb-4 block"
			>
				TibCERT FOCUS //</span
			>
			<h2
				class="text-4xl md:text-5xl font-black uppercase tracking-tight italic text-brand-text"
			>
				Community, Services & Collaboration
			</h2>
			<p
				class="mt-4 text-brand-muted text-base md:text-lg leading-relaxed max-w-2xl mx-auto text-brand-text"
			>
				Explore how TibCERT supports the Tibetan community with secure
				services, trusted community programs, and collaborative
				partnerships.
			</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-3 gap-6 reveal">
			{
				cards.map((card) => (
					<div class="group relative overflow-hidden bg-brand-surface hover:bg-brand-surface/80 border border-brand-text/5 hover:border-brand-surface/30 p-8 transition-all duration-500 flex flex-col justify-between">
						<div class="absolute top-0 left-0 w-3 h-3 border-t border-l border-brand-text/10 group-hover:border-brand-red/40 transition-colors" />
						<div class="absolute bottom-0 right-0 w-3 h-3 border-b border-r border-brand-text/10 group-hover:border-brand-red/40 transition-colors" />
						<span class="font-mono text-[10px] text-brand-red tracking-[0.35em] uppercase mb-3 block opacity-70">
							{card.label}
						</span>
						<h3 class="text-2xl font-black uppercase tracking-tight mb-4">
							{card.title}
						</h3>
						<p class="text-brand-muted leading-relaxed mb-6">
							{card.description}
						</p>
						<a
							href={card.href}
							class="inline-flex items-center gap-2 text-sm uppercase tracking-[0.2em] text-brand-red font-black hover:text-brand-text transition-colors"
						>
							Explore
							<span>&rarr;</span>
						</a>
					</div>
				))
			}
		</div>
	</div>
</section>
