---
import SectionDivider from "../common/SectionDivider.astro";

const testimonials = [
    {
        quote: "TibCERT has been instrumental in strengthening the Tibetan Youth Congress’s digital security and assisting us with technical issues. We greatly appreciate their timely support, expertise in digital empowerment, and dedication to resolving technical challenges.",
        author: "Gompo Dhondup",
        organization: "Tibetan Youth Congress",
        role: "Former President"
    },
    
    {
        quote: "We sincerely appreciate Tibet Action’s outstanding IT support services for our organization. TibCERT’s team consistently responds promptly to our calls and efficiently to technical issues. Their excellent service has significantly contributed to our office's productivity and smooth operations.",
        author: "Tsering Dolma",
        organization: "Central Tibetan Women's Association",
        role: "President"
    },
    {
        quote: "VOT has worked with TibCERT for more than a decade. Apart from supporting our digital security needs and providing guidance and support for different technical needs, TibCERT has been instrumental in managing our website, analyzing our statistics and in providing feedback and solutions for enhanced engagement with our viewers.",
        author: "Tenzin Paldon",
        organization: "Voice Of TIbet",
        role: "Editor in Cheif"
    },
     {
        quote: "The Tibetan Centre for Human Rights and Democracy operates in a highly challenging environment where surveillance, phishing, and cyber threats remain constant risks. TibCERT’s timely support and digital security guidance have played a critical role in helping protect our systems, resources, and sensitive information, while strengthening the broader digital resilience of the Tibetan community.",
        author: "Tenzin Dawa",
        organization: "TCHRD",
        role: "Executive Director"
    },
    {
        quote: "The Tibet Action Institute and TibCERT team have been instrumental in providing digital security training, cybersecurity guidance, and ongoing technical support. Their timely assistance in addressing emerging security concerns and resolving technical challenges has greatly strengthened our organization’s digital resilience and overall digital well-being.",
        author: "Wangden Kyab",
        organization: "Tibet Watch",
        role: "Research Mangager"
    },
    {
        quote: "TibCERT has been a true digital warrior, a vital shield protecting Tibetan communities from malicious attacks, especially those originating from the CCP. SFT-India recognizes digital security as an integral practice and, for this reason, has consistently placed our trust in TibCERT and Tibet Action Network for guidance on our digital security policies.",
        author: "Tenzin Passang",
        organization: "SFT India",
        role: "National Director"
    }
];

// Split testimonials for two marquee rows
const row1 = [...testimonials.slice(0, 4)];
const row2 = [...testimonials.slice(4)];
---

<section class="py-32 relative overflow-hidden reveal">
    <!-- Static Headline -->
    <div class="container mx-auto px-6 mb-20 text-center">
        <div class="max-w-7xl mx-auto">
            <span class="font-mono text-[10px] text-brand-red tracking-[0.4em] mb-4 block uppercase opacity-60">TESTIMONIALS // COMMUNITY_VOICES</span>
            <h2 class="text-4xl md:text-5xl font-black mb-6 uppercase tracking-tight italic">
                Voices from the <span class="text-brand-red">Community</span>
            </h2>
            <SectionDivider class="text-brand-red w-48 mx-auto mb-8" />
            <p class="text-base md:text-lg text-brand-muted leading-relaxed font-light max-w-2xl mx-auto">
                Partnering with organizations to ensure a safer digital future for all Tibetans.
            </p>
        </div>
    </div>

    <!-- Marquee Rows -->
    <div class="space-y-8 relative">
        <!-- Background Accents -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full bg-brand-red/5 blur-[120px] rounded-full pointer-events-none"></div>

        <!-- Row 1: Left to Right -->
        <div class="flex marquee-container overflow-hidden group py-4">
            <div class="flex gap-8 marquee-content-left items-stretch group-hover:[animation-play-state:paused]">
                {[...row1, ...row1, ...row1].map((item, index) => (
                    <div class="flex-shrink-0 bg-brand-void border border-brand-text/5 p-8 w-[340px] min-h-[340px] transition-all relative group/card cursor-default flex flex-col justify-between overflow-hidden">
                        <!-- Technical Accents -->
                        <div class="absolute top-0 left-0 w-2 h-2 border-t border-l border-brand-text/10 group-hover/card:border-brand-red/40 transition-colors"></div>
                        <div class="absolute bottom-0 right-0 w-2 h-2 border-b border-r border-brand-text/10 group-hover/card:border-brand-red/40 transition-colors"></div>
                        
                        <!-- ID Tag -->
                        <div class="absolute top-4 right-4 font-mono text-[8px] text-brand-text/10 uppercase tracking-widest group-hover/card:text-brand-red/30 transition-colors">
                            VOUCHER_{String(index + 1).padStart(3, '0')}
                        </div>

                        <div>
                            <svg class="w-8 h-8 text-brand-red/40 mb-8 group-hover/card:text-brand-red transition-colors" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
                            </svg>
                            
                            <p class="text-brand-text text-base leading-relaxed font-light mb-8">
                                "{item.quote}"
                            </p>
                        </div>
                        
                        <!-- Author Info -->
                        <div class="flex items-center gap-4 border-t border-brand-text/5 pt-6">
                            <div class="w-10 h-10 rounded-sm bg-brand-void border border-brand-text/10 flex items-center justify-center text-brand-red font-mono font-bold text-sm flex-shrink-0 group-hover/card:border-brand-red/40 transition-colors line-height-0">
                                {item.author.charAt(0)}
                            </div>
                            <div class="overflow-hidden">
                                <h4 class="font-black text-xs uppercase tracking-tight text-brand-text line-clamp-1">{item.author}</h4>
                                <p class="text-brand-red font-mono text-[9px] uppercase tracking-widest mt-1 line-clamp-1 opacity-70">{item.role} // {item.organization}</p>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </div>

        <!-- Row 2: Right to Left -->
        <div class="flex marquee-container overflow-hidden group py-4">
            <div class="flex gap-8 marquee-content-right items-stretch group-hover:[animation-play-state:paused]">
                {[...row2, ...row2, ...row2].map((item, index) => (
                    <div class="flex-shrink-0 bg-brand-void border border-brand-text/5 p-8 w-[340px] min-h-[340px] transition-all relative group/card cursor-default flex flex-col justify-between overflow-hidden">
                        <!-- Technical Accents -->
                        <div class="absolute top-0 right-0 w-2 h-2 border-t border-r border-brand-text/10 group-hover/card:border-brand-red/40 transition-colors"></div>
                        <div class="absolute bottom-0 left-0 w-2 h-2 border-b border-l border-brand-text/10 group-hover/card:border-brand-red/40 transition-colors"></div>

                        <!-- ID Tag -->
                        <div class="absolute top-4 left-4 font-mono text-[8px] text-brand-text/10 uppercase tracking-widest group-hover/card:text-brand-red/30 transition-colors">
                            VOUCHER_{String(index + 5).padStart(3, '0')}
                        </div>

                        <div>
                            <svg class="w-8 h-8 text-brand-red/40 mb-8 group-hover/card:text-brand-red transition-colors" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
                            </svg>
                            
                            <p class="text-brand-text text-base leading-relaxed font-light mb-8">
                                "{item.quote}"
                            </p>
                        </div>
                        
                        <!-- Author Info -->
                        <div class="flex items-center gap-4 border-t border-brand-text/5 pt-6">
                            <div class="w-10 h-10 rounded-sm bg-brand-void border border-brand-text/10 flex items-center justify-center text-brand-red font-mono font-bold text-sm flex-shrink-0 group-hover/card:border-brand-red/40 transition-colors line-height-0">
                                {item.author.charAt(0)}
                            </div>
                            <div class="overflow-hidden">
                                <h4 class="font-black text-xs uppercase tracking-tight text-white line-clamp-1">{item.author}</h4>
                                <p class="text-brand-red font-mono text-[9px] uppercase tracking-widest mt-1 line-clamp-1 opacity-70">{item.role} // {item.organization}</p>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </div>
</section>

<style>
    .marquee-container {
        mask-image: linear-gradient(
            to right,
            transparent,
            black 10%,
            black 90%,
            transparent
        );
    }

    .marquee-content-left {
        animation: marquee-scroll-left 40s linear infinite;
    }

    .marquee-content-right {
        animation: marquee-scroll-right 45s linear infinite;
    }

    @keyframes marquee-scroll-left {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(-33.33%);
        }
    }

    @keyframes marquee-scroll-right {
        0% {
            transform: translateX(-33.33%);
        }
        100% {
            transform: translateX(0);
        }
    }

    /* Adjust speeds for mobile */
    @media (max-width: 768px) {
        .marquee-content-left {
            animation-duration: 25s;
        }
        .marquee-content-right {
            animation-duration: 30s;
        }
    }
</style>
