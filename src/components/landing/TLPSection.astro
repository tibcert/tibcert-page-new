---
import SectionShell from "../common/SectionShell.astro";
import SectionHeader from "../common/SectionHeader.astro";

const tlpLevels = [
    {
        name: "TLP:RED",
        color: "#FF0000",
        textColor: "text-white",
        abbreviation: "Not for disclosure, restricted to participants only.",
        description:
            "Sources may use TLP:RED when information cannot be effectively acted upon by additional parties, and could lead to impacts on a party's privacy, reputation, or operations if misused. Recipients may not share TLP:RED information with any parties outside of the specific exchange, meeting, or conversation in which it was originally disclosed.",
    },
    {
        name: "TLP:AMBER",
        color: "#FFC000",
        textColor: "text-black",
        abbreviation:
            "Limited disclosure, restricted to participants’ organizations.",
        description:
            "Sources may use TLP:AMBER when information requires support to be effectively acted upon, yet carries risks to privacy, reputation, or operations if shared outside of the organizations involved. Recipients may only share TLP:AMBER information with members of their own organization, and with clients or customers who need to know.",
    },
    {
        name: "TLP:GREEN",
        color: "#00FF00",
        textColor: "text-black",
        abbreviation: "Limited disclosure, restricted to the community.",
        description:
            "Sources may use TLP:GREEN when information is useful for the awareness of all participating organizations as well as with peers within the broader community or sector. Recipients may share TLP:GREEN information with peers and partner organizations within their sector or community, but not via publicly accessible channels.",
    },
    {
        name: "TLP:CLEAR",
        color: "#FFFFFF",
        textColor: "text-black",
        abbreviation: "Disclosure is not limited.",
        description:
            "Sources may use TLP:CLEAR when information carries minimal or no foreseeable risk of misuse, in accordance with applicable rules and procedures for public release. Subject to standard copyright rules, TLP:CLEAR information may be distributed without restriction.",
    },
];
---

<SectionShell
    id="tlp"
    class="pt-20 pb-16 bg-brand-void reveal"
    containerClass="mx-auto px-4"
    contentClass=""
>
    <!-- Sophisticated Background Elements -->
    <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,#ef482c08_0%,transparent_40%)] pointer-events-none"
    >
    </div>
    <div
        class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-brand-red/5 rounded-full blur-[120px] -mb-64 -mr-64 pointer-events-none"
    >
    </div>

    <div class="relative z-10">
        <div class="">
            <!-- Header -->
            <div
                class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-6"
            >
                <div class="flex-grow max-w-4xl">
                    <SectionHeader
                        eyebrow="Communification Protocol // INFORMATION_SHARING"
                        title="Traffic Light"
                        titleAccent="Protocol (TLP)"
                        description="TLP (Traffic Light Protocol) is a standardized system for labeling sensitive information based on how widely it can be shared. It enables secure exchange of threat intelligence while protecting sensitive data from unintended disclosure. TibCERT uses the TLP as defined by FIRST(Forum of Incident Response and Security Teams) and it is a part of TibCERT policy in terms of information sharing between our core stakeholders."
                    />
                </div>
                <div class="shrink-0 pb-2">
                    <button
                        id="open-tlp-modal"
                        class="inline-flex items-center gap-2.5 px-6 py-3 rounded-sm bg-brand-red border border-brand-red text-white font-mono text-xs uppercase tracking-[0.15em] hover:bg-[#d13d25] hover:border-[#d13d25] transition-all duration-300 shadow-lg shadow-brand-red/15 cursor-pointer group"
                    >
                        <span
                            class="w-2 h-2 rounded-full bg-white animate-pulse"
                        ></span>
                        [ TLP DEFINITION ]
                    </button>
                </div>
            </div>

            <!-- Redesigned Centered Footer -->
            <div
                class="flex flex-col items-center justify-center text-center mt-8 pb-12 border-b border-brand-text/5"
            >
                <div
                    class="bg-brand-void border border-brand-text/5 px-10 py-4 rounded-sm backdrop-blur-sm inline-flex items-center gap-6 group hover:border-brand-red/30 transition-colors"
                >
                    <div
                        class="w-2 h-2 bg-brand-red rounded-full animate-pulse"
                    >
                    </div>
                    <p
                        class="text-brand-muted font-mono text-xs tracking-widest uppercase"
                    >
                        <span class="text-brand-mute normal-case"
                            >TibCERT uses the TLP as defined by FIRST(Forum of
                            Incident Response and Security Teams).</span
                        >
                    </p>
                    <div
                        class="w-2 h-2 bg-brand-red rounded-full animate-pulse"
                    >
                    </div>
                </div>

                <div
                    class="flex items-center gap-8 mt-12 text-[9px] font-mono font-bold text-brand-muted/40 tracking-[0.5em] uppercase"
                >
                    <span>CONFIDENTIALITY</span>
                    <span class="text-brand-red/20 font-light">|</span>
                    <span> Integrity</span>
                    <span class="text-brand-red/20 font-light">|</span>
                    <span> Availability</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Implementation -->
    <div
        id="tlp-modal"
        class="fixed inset-0 z-[9999] hidden items-center justify-center p-4 backdrop-blur-md bg-brand-void/80"
    >
        <div
            class="bg-brand-void border border-brand-text/10 w-full max-w-5xl rounded-sm shadow-2xl overflow-hidden relative"
            id="tlp-modal-content"
        >
            <!-- Modal Glow -->
            <div
                class="absolute -top-24 -right-24 w-64 h-64 bg-brand-red/10 rounded-full blur-[100px] pointer-events-none"
            >
            </div>

            {/* Modal Corner Accents */}
            <div
                class="absolute top-0 left-0 w-4 h-4 border-t border-l border-brand-red/40 pointer-events-none"
            >
            </div>
            <div
                class="absolute bottom-0 right-0 w-4 h-4 border-b border-r border-brand-red/40 pointer-events-none"
            >
            </div>

            <div class="p-8 md:p-12">
                <div class="flex items-center justify-between mb-12">
                    <div class="relative">
                        <span
                            class="font-mono text-[9px] text-brand-red tracking-[0.4em] mb-2 block uppercase opacity-60"
                            >TLP_POLICY // SECURE_SHARING</span
                        >
                        <h3
                            class="text-2xl md:text-3xl font-black text-brand-text uppercase tracking-tight italic"
                        >
                            Traffic Light <span class="text-brand-red"
                                >Protocol</span
                            >
                        </h3>
                    </div>
                    <button
                        id="close-tlp-modal"
                        class="font-mono text-xs uppercase tracking-[0.15em] border border-brand-text/10 text-brand-text hover:text-brand-red hover:border-brand-red px-4 py-2 transition-all duration-300 cursor-pointer rounded-sm"
                    >
                        [ CLOSE_WINDOW ]
                    </button>
                </div>

                <div
                    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 gap-6"
                >
                    {
                        tlpLevels.map((level) => (
                            <div class="flex flex-col h-full rounded-sm overflow-hidden border border-brand-text/5 bg-brand-surface/[0.01] hover:bg-brand-surface/[0.03] transition-all duration-300 relative group">
                                {/* Technical Corner Accents */}
                                <div class="absolute top-0 left-0 w-2 h-2 border-t border-l border-brand-text/10 group-hover:border-brand-red/30 transition-colors" />
                                <div class="absolute bottom-0 right-0 w-2 h-2 border-b border-r border-brand-text/10 group-hover:border-brand-red/30 transition-colors" />

                                <div
                                    class={`h-12 flex items-center justify-center font-mono text-xs uppercase tracking-[0.25em] font-black ${level.textColor}`}
                                    style={`background-color: ${level.color}`}
                                >
                                    [ {level.name} ]
                                </div>
                                <div class="p-6 flex-grow flex flex-col justify-between">
                                    <div class="mb-4">
                                        <h4 class="text-[8px] font-mono font-bold text-brand-red/60 uppercase tracking-widest mb-1.5">
                                            // ABBREVIATION
                                        </h4>
                                        <p class="text-xs font-bold text-brand-text mb-4 opacity-90">
                                            {level.abbreviation}
                                        </p>
                                    </div>

                                    <div>
                                        <h4 class="text-[8px] font-mono font-bold text-brand-red/60 uppercase tracking-widest mb-1.5">
                                            // DESCRIPTION
                                        </h4>
                                        <p class="text-xs font-light text-brand-muted leading-relaxed group-hover:text-brand-text transition-colors">
                                            {level.description}
                                        </p>
                                    </div>
                                </div>
                            </div>
                        ))
                    }
                </div>

                <div
                    class="mt-12 pt-8 border-t border-brand-text/5 text-center"
                >
                    <p
                        class="font-mono text-[9px] text-brand-muted/40 uppercase tracking-[0.4em] flex items-center justify-center gap-4"
                    >
                        <span class="h-px w-8 bg-brand-text/5"></span>
                        STANDARDIZED // INFORMATION_SHARING // POLICY_FIRST
                        <span class="h-px w-8 bg-brand-text/5"></span>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <script>
        function initTLPModal() {
            const modal = document.getElementById("tlp-modal");
            const content = document.getElementById("tlp-modal-content");
            const openBtn = document.getElementById("open-tlp-modal");
            const closeBtn = document.getElementById("close-tlp-modal");

            if (!modal || !openBtn || !closeBtn || !content) return;

            // Move modal to body root to avoid stacking context traps
            if (modal.parentElement !== document.body) {
                document.body.appendChild(modal);
            }

            openBtn.addEventListener("click", () => {
                modal.classList.remove("hidden");
                modal.classList.add("flex");
                document.body.style.overflow = "hidden";

                // Trigger animation
                content.classList.add("animate-modal-in");
            });

            const closeModal = () => {
                modal.classList.add("hidden");
                modal.classList.remove("flex");
                document.body.style.overflow = "auto";
                content.classList.remove("animate-modal-in");
            };

            closeBtn.addEventListener("click", closeModal);

            modal.addEventListener("click", (e) => {
                if (e.target === modal) closeModal();
            });

            // Close on Escape
            window.addEventListener("keydown", (e) => {
                if (e.key === "Escape" && !modal.classList.contains("hidden"))
                    closeModal();
            });
        }

        // Support for View Transitions
        document.addEventListener("astro:page-load", initTLPModal);
        // Initial load
        initTLPModal();
    </script>

    <style>
        @keyframes modal-in {
            from {
                opacity: 0;
                transform: scale(0.95) translateY(10px);
            }
            to {
                opacity: 1;
                transform: scale(1) translateY(0);
            }
        }
        .animate-modal-in {
            animation: modal-in 0.3s ease-out forwards;
        }
    </style>
</SectionShell>
